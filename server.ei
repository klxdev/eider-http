//! http/server: an HTTP/1.1 server over std/net, with deadlines on every wait and graceful
//! shutdown through a cancellation token (docs/services.md "Concurrency").
//!
//! Model: one accepting task (the caller of `serve`) and one task per connection (`spawn`,
//! lightweight tasks, decision C830 of eider-lang). The acceptor starts a task for each
//! connection; the task serves it, request after request, with blocking-style code that parks
//! when it waits: it waits on the connection's socket and the server's stop signal together
//! (`fd.wait_ready2`, no poller per connection) with a deadline, parses incrementally
//! (parse.ei), calls the handler, and writes the response before its write deadline. No
//! shared mutable state except one Lock of counters. `workers` is the number of connections
//! served at once (default 10,000) and `queue` the number allowed to wait for a slot.
//!
//! - Back-pressure: accepted connections wait for a slot (at most `queue` of them); when that
//!   is full the acceptor answers `503` and closes. While connections wait, a connection gives up
//!   keep-alive after the current response (`Connection: close`), so idle
//!   keep-alive clients can't starve new ones.
//! - Deadlines (per connection): `idle_timeout` while waiting for a request to start (a new
//!   connection, or between keep-alive requests; then the connection is just closed);
//!   `read_timeout` from a request's first byte to its last (then `408`); `write_timeout`
//!   for sending one response (then the connection is dropped). `max_requests` per
//!   connection, then `Connection: close`.
//! - Errors in a request are answered with the parser's status (400, 413, 414, 431, 501,
//!   505) and the connection is closed: after a framing error the next request can't be
//!   found safely. Closing after a response half-closes and drains what the client still
//!   sends for a moment (a lingering close), so the client reads the response instead of a
//!   reset.
//! - Shutdown: cancel the token given to `serve`. The acceptor takes the connections already
//!   in the listen backlog, then closes the listener; every connection finishes the request it
//!   is reading or handling (answering it with `Connection: close`), closes idle connections
//!   at once, and serves a queued connection only if its request has already arrived.
//!   `serve` returns when every connection is done.
//!
//! A handler runs in the connection's task and must not block forever (nothing can interrupt
//! it; a handler that computes without waiting holds a scheduler thread).
//! A trap (panic, overflow) in a handler ends the whole process, as any trap does today.

import core.sys
import std.bytes
import std.fd
import std.net
import std.poll
import std.stream
import std.time
import std.task
import std.chan
import std.sync
import http
import http.parse
import http.sock

pub type Config = {
    workers: usize,
    queue: usize,
    idle_timeout: time.Duration,
    read_timeout: time.Duration,
    write_timeout: time.Duration,
    max_requests: u32,
    limits: http.Limits,
    date: bool,
    plan: http.Planner,
}

/// 10,000 connections served at once, a queue of 64, 5 s idle, 10 s to read a request, 10 s to write a
/// response, 1000 requests per connection, the default parser limits, `Date` headers, and no
/// per-route plan (`cfg.plan = router.planner()` gives routes their own body limits, enforced
/// before the body is read, and streamed request bodies: `http.Plan`).
pub fn config() -> Config {
    Config(10000, 64, time.seconds(5), time.seconds(10), time.seconds(10), 1000, http.limits(), true, no_plan)
}

fn no_plan(method: List[u8], path: List[u8]) -> http.Plan { http.Plan(0, false) }

/// What a server did, counted over its life.
/// `connections`: accepted and handed to a worker; `rejected`: answered 503 because the
/// queue was full; `requests`: handled; `bad`: refused by the parser; `timeouts`: a request
/// that didn't arrive in time (408) or a response that couldn't be written in time.
pub type Stats = { connections: i64, rejected: i64, requests: i64, bad: i64, timeouts: i64 }

type Shared = { stats: Stats, waiting: i64 }

/// A listening server (bound, not yet serving).
pub type Server = { ls: i32, addr: net.Addr, cfg: Config }

/// Binds and listens on `a` (port 0: any free port; `addr()` says which).
pub fn listen(a: net.Addr, cfg: Config) -> Result[Server, String] uses net, io {
    if cfg.workers == 0 || cfg.queue == 0 { return Err(String.from("server: workers and queue must be at least 1")) }
    let ls = net.listener(a, true)?
    match net.local_addr(ls) {
        Ok(la) => Ok(Server(ls, la, cfg))
        Err(e) => {
            fd.close(ls)
            Err(e)
        }
    }
}

fn bump(sh: sync.Lock[Shared], what: i32) {
    sh.modify(|inout t: Shared| -> () {
        if what == 0 { t.stats.connections += 1 }
        if what == 1 { t.stats.rejected += 1 }
        if what == 2 { t.stats.requests += 1 }
        if what == 3 { t.stats.bad += 1 }
        if what == 4 { t.stats.timeouts += 1 }
        if what == 5 { t.waiting += 1 }
        if what == 6 { t.waiting -= 1 }
    })
}

fn waiting(sh: sync.Lock[Shared]) -> i64 { sh.modify(|inout s: Shared| -> i64 s.waiting) }

impl Server {
    /// The address the server listens on (with the real port when it was 0).
    fn addr(self) -> net.Addr { self.addr }

    fn port(self) -> i32 { self.addr.port }

    /// Serves connections with `h` until `tok` is cancelled (or expires), then shuts down
    /// gracefully (see the module comment) and returns the counts. Closes the listener.
    /// Err only when the server can't start (no poller, waker or threads).
    fn serve(self, h: http.Handler, tok: task.Token) -> Result[Stats, String] uses net, io, clock, threads {
        let cfg = self.cfg
        let ls = self.ls
        let stop = match poll.waker() {
            Ok(w) => w
            Err(e) => {
                fd.close(ls)
                return Err(e)
            }
        }
        // the stop signal: a waker that is woken once and never drained, so every wait
        // that watches it (the acceptor's and each connection's) sees it from then on
        let stopper = tok.child()
        let st = stopper
        let sw = stop
        let watcher = spawn(|| -> i32 {
            st.wait(time.never())
            poll.wake(sw)
            0
        })
        let sh = sync.lock(Shared(Stats(0, 0, 0, 0, 0), 0))
        // `workers` slots: a connection holds one while it is served
        let slots: chan.Channel[bool] = chan.bounded(cfg.workers)
        for i in 0..cfg.workers { let z = slots.try_send(true) }
        let done: chan.Channel[i64] = chan.unbounded()
        let mut conns: Map[i64, Task[i32]] = Map.new()
        let mut next: i64 = 1
        let mut running = true
        while running {
            // either the listener has connections or the stop signal has come
            let mut accept_now = false
            match fd.wait_ready2(ls, fd.READY_READ, stop.r, fd.READY_READ, time.never()) {
                Ok(r) => {
                    if r.second != 0 { running = false }
                    if r.first != 0 { accept_now = true }
                }
                Err(e) => { running = false }
            }
            // on the stop, connections already in the backlog are still taken: they are
            // served if their request has arrived (and not reset by closing the listener)
            if accept_now || !running { accept_some(ls, stop, h, cfg, sh, slots, done, inout conns, inout next) }
        }
        fd.close(ls)
        // every connection still runs (and sees the stop); then the tasks end
        for t in conns.values() { let z = t.join() }
        stopper.cancel()
        let z = watcher.join()
        tok.detach(stopper)
        poll.close_waker(stop)
        Ok(sh.get().stats)
    }
}

/// Joins the connection tasks that have finished (their ids are in `done`).
fn reap(done: chan.Channel[i64], inout conns: Map[i64, Task[i32]]) uses io {
    let mut going = true
    while going {
        match done.try_recv() {
            chan.Value(id) => {
                match conns.get(id) {
                    Some(t) => {
                        let gone = conns.remove(id)
                        let z = t.join()
                    }
                    None => {}
                }
            }
            chan.Empty => { going = false }
            chan.Closed => { going = false }
        }
    }
}

/// Accepts what is pending (at most 64 at a time, so a flood can't starve the stop check) and
/// starts a task for each connection: with a slot if one is free, else waiting for one if fewer
/// than `queue` connections wait, else answering 503.
fn accept_some(ls: i32, stop: poll.Waker, h: http.Handler, cfg: Config, sh: sync.Lock[Shared], slots: chan.Channel[bool], done: chan.Channel[i64], inout conns: Map[i64, Task[i32]], inout next: i64) uses net, io, clock, threads {
    reap(done, inout conns)
    for k in 0..64 {
        match net.accept(ls, true) {
            Ok(Some(a)) => {
                let c = a.fd
                let peer = net.text(a.peer)
                let nd = net.set_option(c, net.NODELAY, 1)
                let admitted = match slots.try_recv() {
                    chan.Value(v) => true
                    chan.Empty => false
                    chan.Closed => false
                }
                if !admitted && waiting(sh) >= cfg.queue as i64 {
                    bump(sh, 1)
                    reject(c, cfg)
                } else {
                    if !admitted { bump(sh, 5) }
                    bump(sh, 0)
                    let id = next
                    next += 1
                    let t = spawn(|| -> i32 {
                        serve_conn(c, peer, h, cfg, stop, sh, slots, admitted, done, id)
                        0
                    })
                    conns.insert(id, t)
                }
            }
            Ok(None) => { return }
            Err(e) => {
                // ECONNABORTED and friends: the next one may be fine; EMFILE: back off a
                // little (the stop signal ends the wait early)
                let z = fd.wait_ready(stop.r, fd.READY_READ, time.after_ms(20))
                return
            }
        }
    }
}

/// 503 without reading anything (best effort: the socket's send buffer is empty).
fn reject(c: i32, cfg: Config) uses net, io, clock {
    let mut r = http.error_response(503)
    r.set_header("Retry-After", sys.lit("1"))
    match http.write_response(r, false, false, date_of(cfg)) {
        Ok(b) => {
            let z = net.send(c, b)
        }
        Err(e) => {}
    }
    sock.linger_close(c, time.after_ms(100))
}

fn date_of(cfg: Config) -> List[u8] uses clock {
    if !cfg.date { return List.new() }
    http.imf_date(time.unix_seconds())
}

/// Whether the stop signal has come (its waker is readable, and stays so), without waiting.
fn stop_signalled(stop: poll.Waker) -> bool uses io, clock {
    fd.wait_ready(stop.r, fd.READY_READ, time.now()).unwrap_or(false)
}

/// What a wait on a connection ended with.
type Wake = | Readable | TimedOut | Stopped | Failed

/// Waits for the connection `c` to be readable, the stop signal (while `watch` says to watch
/// it: once seen it stays readable, so it is dropped), or `dl`.
fn wait_conn(c: i32, stop: poll.Waker, watch: sync.Lock[bool], dl: time.Deadline) -> Wake uses io, clock {
    let watching = watch.modify(|inout w: bool| -> bool w)
    if watching {
        match fd.wait_ready2(c, fd.READY_READ, stop.r, fd.READY_READ, dl) {
            Ok(r) => {
                // the stop comes first: the caller then reads with stopping set
                if r.second != 0 { return Stopped }
                if r.first != 0 { return Readable }
                return TimedOut
            }
            Err(e) => { return Failed }
        }
    }
    match fd.wait_ready(c, fd.READY_READ, dl) {
        Ok(ready) => {
            if ready { return Readable }
            TimedOut
        }
        Err(e) => Failed
    }
}

fn unwatch(watch: sync.Lock[bool]) { watch.modify(|inout w: bool| -> () { w = false }) }

/// Answers a refused request (the connection is closed after it).
fn refuse(c: i32, status: i32, cfg: Config) uses net, io, clock {
    match http.write_response(http.error_response(status), false, false, date_of(cfg)) {
        Ok(b) => {
            let sent = sock.send_by(c, b, time.after(cfg.write_timeout))
        }
        Err(e) => {}
    }
}

fn is_head(m: List[u8]) -> bool { m.len() == 4 && m[0] == 72 && m[1] == 69 && m[2] == 65 && m[3] == 68 }

/// The parser of a connection while a handler reads a streamed request body through it.
type Link = { parser: parse.Parser }

fn earlier(a: time.Deadline, b: time.Deadline) -> time.Deadline {
    if a.at_ns < b.at_ns { return a }
    b
}

/// The next bytes of a streamed request body, at most `max`, waiting for the client no longer
/// than `dl` and `read_timeout` (empty: the body is complete). Holds the connection's parser
/// (`l`); reads the socket when the parser has nothing to give.
fn pull_once(inout l: Link, max: usize, dl: time.Deadline, c: i32, watch: sync.Lock[bool], cfg: Config, stop: poll.Waker) -> Result[List[u8], stream.Error] uses net, io, clock {
    let limit = earlier(dl, time.after(cfg.read_timeout))
    while true {
        match l.parser.body_next(max) {
            parse.Data(b) => { return Ok(b) }
            parse.End => { return Ok(List.new()) }
            parse.Broken(st, why) => {
                return Err(stream.error_text(stream.InvalidData, sys.to_string(why)))
            }
            parse.Wait => {
                if l.parser.wants_continue() {
                    l.parser.continue_sent()
                    let cont = sys.lit("HTTP/1.1 100 Continue\r\n\r\n")
                    if !sock.send_by(c, cont, time.after(cfg.write_timeout)) { return Err(stream.error(stream.BrokenPipe, "the client went away")) }
                }
                match wait_conn(c, stop, watch, limit) {
                    Readable => {
                        match net.try_recv(c, 65536) {
                            Ok(Some(b)) => {
                                if b.len() == 0 {
                                    let z = l.parser.eof()
                                    return Err(stream.error(stream.UnexpectedEof, "the client closed the connection before the end of the body"))
                                }
                                l.parser.feed(b)
                            }
                            Ok(None) => {}
                            Err(e) => { return Err(stream.error_text(stream.Other, e)) }
                        }
                    }
                    TimedOut => { return Err(stream.error(stream.TimedOut, "timed out waiting for the request body")) }
                    // the server is stopping: the body already on its way is still read
                    Stopped => { unwatch(watch) }
                    Failed => { return Err(stream.error(stream.Other, "poll failed")) }
                }
            }
        }
    }
    Err(stream.error(stream.Other, "unreachable"))
}

fn body_pull(link: sync.Lock[Link], c: i32, watch: sync.Lock[bool], cfg: Config, stop: poll.Waker) -> http.Pull uses net, io, clock {
    |max: usize, dl: time.Deadline| -> Result[List[u8], stream.Error] {
        link.modify(|inout l: Link| -> Result[List[u8], stream.Error] { pull_once(inout l, max, dl, c, watch, cfg, stop) })
    }
}

/// Reads and drops the rest of a streamed body: whether it ended cleanly.
fn drain_body(link: sync.Lock[Link], c: i32, watch: sync.Lock[bool], cfg: Config, stop: poll.Waker) -> bool uses net, io, clock {
    link.modify(|inout l: Link| -> bool {
        while true {
            match pull_once(inout l, 65536, time.after(cfg.read_timeout), c, watch, cfg, stop) {
                Ok(b) => {
                    if b.len() == 0 { return true }
                }
                Err(e) => { return false }
            }
        }
        false
    })
}

fn closed_err() -> stream.Error { stream.error(stream.BrokenPipe, "the connection is closed") }

/// Sends a streamed response (`http.Stream`): the head, then `run` with a Duplex on the
/// connection. Returns what ends the connection (0 keep serving, 1 lingering close, 2 close now).
/// `left` is what the parser read beyond the request (for an upgrade: the first bytes the
/// client sent after its handshake).
fn run_stream(c: i32, watch: sync.Lock[bool], resp: http.Response, stm: http.Stream, keep: bool, left: List[u8], cfg: Config, stop: poll.Waker) -> i32 uses net, io, clock {
    let head = match http.write_stream_head(resp, stm.raw, keep, date_of(cfg)) {
        Ok(b) => b
        Err(e) => { return 2 }
    }
    if !sock.send_by(c, head, time.after(cfg.write_timeout)) { return 2 }
    let pending = sync.lock(left)
    let raw = stm.raw
    let recv = |max: usize, dl: time.Deadline| -> Result[List[u8], stream.Error] {
        let early = pending.modify(|inout b: List[u8]| -> List[u8] {
            if b.len() == 0 { return List.new() }
            let n = if b.len() < max { b.len() } else { max }
            let out = bytes.slice(b, 0, n)
            b = bytes.slice(b, n, b.len())
            out
        })
        if early.len() > 0 { return Ok(early) }
        if !raw { return Err(stream.error(stream.Unsupported, "a chunked response has nothing to read")) }
        while true {
            match wait_conn(c, stop, watch, dl) {
                Readable => {
                    match net.try_recv(c, max as i64) {
                        Ok(Some(b)) => { return Ok(b) }
                        Ok(None) => {}
                        Err(e) => { return Err(stream.error_text(stream.Other, e)) }
                    }
                }
                TimedOut => { return Err(stream.error(stream.TimedOut, "timed out")) }
                Stopped => {
                    unwatch(watch)
                    return Err(stream.error(stream.Interrupted, "the server is stopping"))
                }
                Failed => { return Err(stream.error(stream.Other, "poll failed")) }
            }
        }
        Err(closed_err())
    }
    let send = |data: List[u8]| -> Result[(), stream.Error] {
        if data.len() == 0 { return Ok(()) }
        let wire = if raw { data } else { http.chunk(data) }
        if sock.send_by(c, wire, time.after(cfg.write_timeout)) { return Ok(()) }
        Err(closed_err())
    }
    let stopping = || -> bool { stop_signalled(stop) }
    let run = stm.run
    run(http.Duplex(recv, send, stopping))
    if raw { return 1 }
    if !sock.send_by(c, sys.lit("0\r\n\r\n"), time.after(cfg.write_timeout)) { return 2 }
    if keep { return 0 }
    1
}

/// A connection's task: waits for a slot if it was accepted without one, serves the connection,
/// gives the slot back and tells the acceptor it is done (so its Task can be joined).
fn serve_conn(c: i32, peer: List[u8], h: http.Handler, cfg: Config, stop: poll.Waker, sh: sync.Lock[Shared], slots: chan.Channel[bool], admitted: bool, done: chan.Channel[i64], id: i64) uses net, io, clock {
    if !admitted {
        // accepted while every slot was taken: wait for one (the acceptor counted this
        // connection as waiting, so at most `queue` of them are parked here)
        let got = slots.recv(time.never())
        bump(sh, 6)
    }
    serve_slot(c, peer, h, cfg, stop, sh)
    let back = slots.try_send(true)
    let fin = done.try_send(id)
}

/// One connection, request after request (see the module comment), with its slot held. Owns
/// `c`; `peer` is the client's address as text (it goes in every Request).
fn serve_slot(c: i32, peer: List[u8], h: http.Handler, cfg: Config, stop: poll.Waker, sh: sync.Lock[Shared]) uses net, io, clock {
    let watch = sync.lock(true)
    let mut ok = true
    let mut stopping = false
    let mut parser = parse.requests(cfg.limits)
    parser.set_plan(cfg.plan)
    let mut served: u32 = 0
    // what ends the connection: 0 keep going, 1 close after a response (a lingering
    // close), 2 close now
    let mut end = 0
    if !ok { end = 2 }
    while end == 0 {
        // read one request
        let mut started = !parser.idle()
        let mut dl = if started { time.after(cfg.read_timeout) } else { time.after(cfg.idle_timeout) }
        let mut got: Option[parse.Msg] = None
        while end == 0 && got.is_none() {
            match parser.next() {
                parse.Done(m) => { got = Some(m) }
                parse.Bad(status, why) => {
                    bump(sh, 3)
                    refuse(c, status, cfg)
                    end = 1
                }
                parse.More => {
                    if parser.wants_continue() {
                        parser.continue_sent()
                        let cont = sys.lit("HTTP/1.1 100 Continue\r\n\r\n")
                        if !sock.send_by(c, cont, time.after(cfg.write_timeout)) { end = 2 }
                    }
                    if end == 0 && stopping && parser.idle() {
                        // shutting down: serve a request only if it has already arrived
                        match net.try_recv(c, 65536) {
                            Ok(Some(b)) => {
                                if b.len() == 0 { end = 2 } else { parser.feed(b) }
                            }
                            Ok(None) => { end = 2 }
                            Err(e) => { end = 2 }
                        }
                        if end == 0 && !started {
                            started = true
                            dl = time.after(cfg.read_timeout)
                        }
                    } else if end == 0 {
                        match wait_conn(c, stop, watch, dl) {
                            Readable => {
                                match net.try_recv(c, 65536) {
                                    Ok(Some(b)) => {
                                        if b.len() == 0 {
                                            // the peer closed (or half-closed) its side
                                            if parser.idle() {
                                                end = 2
                                            } else {
                                                match parser.eof() {
                                                    parse.Done(m) => { got = Some(m) }
                                                    parse.Bad(status, why) => {
                                                        bump(sh, 3)
                                                        refuse(c, status, cfg)
                                                        end = 1
                                                    }
                                                    parse.More => { end = 2 }
                                                }
                                            }
                                        } else {
                                            parser.feed(b)
                                            if !started {
                                                started = true
                                                dl = time.after(cfg.read_timeout)
                                            }
                                        }
                                    }
                                    Ok(None) => {}
                                    Err(e) => { end = 2 }
                                }
                            }
                            TimedOut => {
                                if started {
                                    bump(sh, 4)
                                    refuse(c, 408, cfg)
                                    end = 1
                                } else {
                                    end = 2
                                }
                            }
                            Stopped => {
                                stopping = true
                                unwatch(watch)
                            }
                            Failed => { end = 2 }
                        }
                    }
                }
            }
        }
        if end != 0 { break }
        let m = got.unwrap()
        // handle it
        served += 1
        bump(sh, 2)
        let streaming_req = m.streaming
        let mut req = parse.to_request(m)
        req.peer = peer
        let head_only = is_head(req.method)
        // `stopping` is what the last wait saw; the stop may have come after it, while the
        // rest of this request was read (a wait that saw only data, then a read that got the
        // bytes sent after the stop too), so the signal is checked again here: a request in
        // flight at the stop is answered with `Connection: close`
        if !stopping && stop_signalled(stop) { stopping = true }
        let mut keep = req.keep_alive && served < cfg.max_requests && !stopping && waiting(sh) == 0
        let mut resp = http.response(500)
        if streaming_req {
            // the body is read by the handler as it goes: the parser is shared with the reader
            let link = sync.lock(Link(parser.copy()))
            req.stream = Some(http.Body(body_pull(link, c, watch, cfg, stop)))
            resp = h(req)
            // what the handler left unread is read and dropped; a body that can't be finished
            // ends the connection after the response
            if !drain_body(link, c, watch, cfg, stop) { keep = false }
            parser = link.get().parser.copy()
        } else {
            resp = h(req)
        }
        match resp.stream {
            Some(stm) => {
                if head_only {
                    let mut hr = resp.copy()
                    hr.stream = None
                    hr.body = List.new()
                    resp = hr
                } else {
                    let left = bytes.slice(parser.buf, parser.pos, parser.buf.len())
                    end = run_stream(c, watch, resp, stm, keep, left, cfg, stop)
                    if end == 0 { resp.keep_alive = true }
                    if end != 0 { break }
                    continue
                }
            }
            None => {}
        }
        let out = match http.write_response(resp, head_only, keep, date_of(cfg)) {
            Ok(b) => b
            Err(e) => http.write_response(http.error_response(500), head_only, false, date_of(cfg)).unwrap()
        }
        if !sock.send_by(c, out, time.after(cfg.write_timeout)) {
            bump(sh, 4)
            end = 2
        } else if !keep || !resp.keep_alive {
            end = 1
        }
    }
    if end == 1 { sock.linger_close(c, time.after_ms(1000)) }
    if end == 2 { fd.close(c) }
}
