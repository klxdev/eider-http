//! http/server: an HTTP/1.1 server over std/net, with deadlines on every wait and graceful
//! shutdown through a cancellation token (docs/services.md "Concurrency").
//!
//! Model: one accepting task (the caller of `serve`) and one task per connection (`spawn`,
//! lightweight tasks, decision C830 of eider-lang). The acceptor starts a task for each
//! connection; the task serves it, request after request, with blocking-style code that parks
//! when it waits: it waits on the connection's socket and the server's stop signal together
//! (`fd.wait_ready_or_unpark` on the connection's own parker, which the stop unparks: no poller
//! per connection, and one registration with the runtime's poller per wait) with a deadline,
//! parses incrementally (parse.ei), calls the handler, and writes the response before its write
//! deadline (sending first, and waiting for writability only when the buffer is full). No
//! shared mutable state except one Lock of rarely changed counters; the per-request counters and
//! the stop flag are atomics. `workers` is the number of connections
//! served at once (default 10,000) and `queue` the number allowed to wait for a slot.
//!
//! - Back-pressure: accepted connections wait for a slot (at most `queue` of them); when that
//!   is full the acceptor answers `503` and closes. While connections wait, a connection gives up
//!   keep-alive after the current response (`Connection: close`), so idle
//!   keep-alive clients can't starve new ones.
//! - Deadlines (per connection): `idle_timeout` while waiting for a request to start (a new
//!   connection, or between keep-alive requests; then the connection is just closed);
//!   `read_timeout` from a request's first byte to its last (then `408`); `write_timeout`
//!   for sending one response (then the connection is dropped). `max_requests` per
//!   connection, then `Connection: close`.
//! - Errors in a request are answered with the parser's status (400, 413, 414, 431, 501,
//!   505; 501 for a transfer coding other than chunked, except one gzip, deflate or zstd before
//!   chunked, which is decoded with hard limits: `Config.decode_max`) and the connection is closed: after a framing error the next request can't be
//!   found safely. Closing after a response half-closes and drains what the client still
//!   sends for a moment (a lingering close), so the client reads the response instead of a
//!   reset.
//! - Shutdown: cancel the token given to `serve`. The acceptor takes the connections already
//!   in the listen backlog, then closes the listener; every connection finishes the request it
//!   is reading or handling (answering it with `Connection: close`), closes idle connections
//!   at once, and serves a queued connection only if its request has already arrived.
//!   `serve` returns when every connection is done.
//!
//! - TLS: with `Config.secure` (http/secure; `service.options().with_tls(...)`) every accepted connection
//!   runs the TLS 1.3 handshake in its own task, after it took its slot and before its first request,
//!   within the acceptor's handshake timeout and bound on concurrent handshakes; one that fails is closed
//!   (`Stats.tls_failed`). From then on the code is the same: reads, writes, waits and closes are
//!   `transport.Transport`'s (http/transport), which imports no TLS.
//!
//! A handler runs in the connection's task and must not block forever (nothing can interrupt
//! it; a handler that computes without waiting holds a scheduler thread).
//!
//! A trap (panic, overflow, out-of-bounds, failed assert) in a handler, or in the producer of a
//! streamed response, is contained at the handler call (`task.catch`, eider-lang's decision
//! C803): the client gets `500 Internal Server Error` with the standard text and nothing of
//! the trap, the trap (text, file and line, the method and the path) is logged with
//! `Config.log`, `Stats.traps` counts it, and the connection is closed after the response (a
//! handler that trapped may have left a half-read request body or state we know nothing
//! about). What the handler was building leaks and a `sync.Lock` it held in `modify` stays empty
//! (eider-lang's docs/runtime.md "What is safe afterwards"); the server's own state is never
//! touched by a handler, so every other connection, the listener and the counters carry on.
//! A stack overflow is not contained. `middleware.recover` does the same one layer inside
//! the access log and the metrics, so they see the 500.

import core.sys
import std.bytes
import std.fd
import std.net
import std.poll
import std.stream
import std.time
import std.task
import std.chan
import std.sync
import std.atomic
import logging
import std.utf8
import http
import http.parse
import http.sock
import http.transport
import http.middleware
import http.metrics
import http.compress
import http.h2
import compression

pub type Config = {
    workers: usize,
    queue: usize,
    idle_timeout: time.Duration,
    read_timeout: time.Duration,
    write_timeout: time.Duration,
    max_requests: u32,
    limits: http.Limits,
    date: bool,
    plan: http.Planner,
    log: Option[logging.Logger],
    decode_max: usize,
    secure: Option[transport.Acceptor],
    h2: Option[h2.Options],
    h2_wrap: Option[h2.Middleware],
}

/// 10,000 connections served at once, a queue of 64, 5 s idle, 10 s to read a request, 10 s to write a
/// response, 1000 requests per connection, the default parser limits, `Date` headers, and no
/// per-route plan (`cfg.plan = router.planner()` gives routes their own body limits, enforced
/// before the body is read, and streamed request bodies: `http.Plan`), and traps in handlers logged
/// at error level to stderr (`None` turns that off; the 500 and `Stats.traps` stay). A request body
/// with a transfer coding (`Transfer-Encoding: gzip, chunked`) is decoded (gzip, deflate or zstd;
/// http/compress) to at most `decode_max` bytes (0: the route's body limit, `Plan.max_body` or
/// `limits.max_body`) and at most 1100 times its size: 413 when it goes over, 400 when the data is
/// corrupt or cut short; other codings are 501. `secure` None: plain HTTP; `Some(acceptor)` (from
/// http/secure, or `service.options().with_tls(...)`) serves https: every accepted connection runs the TLS
/// handshake (bounded by the acceptor's handshake timeout and limit on concurrent handshakes) before its
/// first request. `h2` None: HTTP/1.1 only, as before; `Some(options)` (`h2.options()`) also serves HTTP/2 on the same
/// port: a connection that opens with the HTTP/2 preface (prior-knowledge h2c) or that negotiated ALPN `h2` (https,
/// `ServerTls.with_h2()`) is HTTP/2, every request stream calling the same handler (docs/services.md "HTTP/2").
pub fn config() -> Config {
    Config(10000, 64, time.seconds(5), time.seconds(10), time.seconds(10), 1000, http.limits(), true, no_plan, Some(logging.new(logging.Error)), 0, None, None, None)
}

fn no_plan(method: List[u8], path: List[u8]) -> http.Plan { http.Plan(0, false) }

/// What a server did, counted over its life.
/// `connections`: accepted and handed to a worker; `rejected`: answered 503 because the
/// queue was full; `requests`: handled; `bad`: refused by the parser; `timeouts`: a request
/// that didn't arrive in time (408) or a response that couldn't be written in time; `traps`:
/// handlers (or response producers) that trapped and were contained (answered 500); `tls_failed`:
/// connections whose TLS handshake failed or timed out (they were closed; never counted in `requests`).
pub type Stats = { connections: i64, rejected: i64, requests: i64, bad: i64, timeouts: i64, traps: i64, tls_failed: i64 }

pub type Shared = { stats: Stats }

/// What the server shares between its tasks without a lock on the per-request path: the stop flag
/// (set once, read with one atomic load), the two counters a request touches (handled, and
/// connections waiting for a slot), and the parkers of the live connections, which the stop
/// unparks so that a connection parked in a wait wakes at once (`fd.wait_ready_or_unpark`: one
/// registration with the poller per wait, where a waker descriptor for the stop would be two).
type Live = { flag: atomic.Atomic, reqs: atomic.Atomic, waiting: atomic.Atomic, pks: sync.Lock[Map[i64, sync.Parker]] }

fn live() -> Live { Live(atomic.new(0), atomic.new(0), atomic.new(0), sync.lock(Map.new())) }

/// The counters and the connection registry, as the tasks hold them.
type Hub = { lock: sync.Lock[Shared], live: Live }

/// What one connection sees of the stop: the flag, and its own parker.
type Sig = { flag: atomic.Atomic, pk: sync.Parker }

/// A listening server (bound, not yet serving).
pub type Server = { ls: i32, addr: net.Addr, cfg: Config, sh: Hub }

/// Binds and listens on `a` (port 0: any free port; `addr()` says which).
pub fn listen(a: net.Addr, cfg: Config) -> Result[Server, String] uses net, io {
    if cfg.workers == 0 || cfg.queue == 0 { return Err(String.from("server: workers and queue must be at least 1")) }
    let ls = net.listener(a, true)?
    match net.local_addr(ls) {
        Ok(la) => Ok(Server(ls, la, cfg, Hub(sync.lock(Shared(Stats(0, 0, 0, 0, 0, 0, 0))), live())))
        Err(e) => {
            fd.close(ls)
            Err(e)
        }
    }
}

fn bump(sh: Hub, what: i32) {
    if what == 2 {
        let n = sh.live.reqs.add(1, atomic.Relaxed)
        return
    }
    if what == 5 {
        let n = sh.live.waiting.add(1, atomic.Relaxed)
        return
    }
    if what == 6 {
        let n = sh.live.waiting.sub(1, atomic.Relaxed)
        return
    }
    sh.lock.modify(|inout t: Shared| -> () {
        if what == 0 { t.stats.connections += 1 }
        if what == 1 { t.stats.rejected += 1 }
        if what == 3 { t.stats.bad += 1 }
        if what == 4 { t.stats.timeouts += 1 }
        if what == 7 { t.stats.traps += 1 }
        if what == 8 { t.stats.tls_failed += 1 }
    })
}

fn waiting(sh: Hub) -> i64 { sh.live.waiting.load(atomic.Relaxed) }

/// The counts so far.
fn snapshot(sh: Hub) -> Stats {
    let mut st = sh.lock.get().stats
    st.requests = sh.live.reqs.load(atomic.Relaxed)
    st
}

/// Registers a connection's parker with the stop; a connection that starts after the stop is woken at once.
fn live_join(lv: Live, id: i64, pk: sync.Parker) uses io {
    lv.pks.modify(|inout m: Map[i64, sync.Parker]| -> () {
        m.insert(id, pk)
        if lv.flag.load(atomic.Acquire) != 0 { pk.unpark() }
    })
}

fn live_leave(lv: Live, id: i64) {
    lv.pks.modify(|inout m: Map[i64, sync.Parker]| -> () { let gone = m.remove(id) })
}

/// The stop: sets the flag, then wakes every connection parked in a wait.
fn live_stop(lv: Live) uses io {
    lv.flag.store(1, atomic.Release)
    lv.pks.modify(|inout m: Map[i64, sync.Parker]| -> () {
        for pk in m.values() { pk.unpark() }
    })
}

impl Server {
    /// The address the server listens on (with the real port when it was 0).
    fn addr(self) -> net.Addr { self.addr }

    fn port(self) -> i32 { self.addr.port }

    /// The counts so far (while serving, or after).
    fn stats(self) -> Stats { snapshot(self.sh) }

    /// Connections waiting for a slot now.
    fn waiting(self) -> i64 { waiting(self.sh) }

    /// Adds the server's counters to `m`'s exposition: `http_server_connections_total`,
    /// `http_server_connections_rejected_total` (503), `http_server_requests_handled_total`,
    /// `http_server_bad_requests_total` (refused by the parser), `http_server_timeouts_total`,
    /// `http_server_handler_traps_total` (contained, answered 500), `http_server_tls_handshake_failures_total`
    /// and the gauge
    /// `http_server_connections_waiting`.
    fn expose(self, m: metrics.Metrics) {
        let sv = self
        m.add_source(|| -> List[u8] {
            let s = sv.stats()
            let mut o: List[u8] = List.new()
            bytes.append(inout o, metrics.counter_text("http_server_connections_total", "Connections accepted.", s.connections))
            bytes.append(inout o, metrics.counter_text("http_server_connections_rejected_total", "Connections answered 503 because the queue was full.", s.rejected))
            bytes.append(inout o, metrics.counter_text("http_server_requests_handled_total", "Requests handed to the handler.", s.requests))
            bytes.append(inout o, metrics.counter_text("http_server_bad_requests_total", "Requests the parser refused.", s.bad))
            bytes.append(inout o, metrics.counter_text("http_server_timeouts_total", "Requests that did not arrive, or responses that could not be written, in time.", s.timeouts))
            bytes.append(inout o, metrics.counter_text("http_server_handler_traps_total", "Handlers that trapped and were answered 500.", s.traps))
            bytes.append(inout o, metrics.counter_text("http_server_tls_handshake_failures_total", "Connections whose TLS handshake failed or timed out.", s.tls_failed))
            bytes.append(inout o, metrics.gauge_text("http_server_connections_waiting", "Connections waiting for a worker slot.", sv.waiting()))
            o
        })
    }

    /// Serves connections with `h` until `tok` is cancelled (or expires), then shuts down
    /// gracefully (see the module comment) and returns the counts. Closes the listener.
    /// Err only when the server can't start (no poller, waker or threads).
    fn serve(self, h: http.Handler, tok: task.Token) -> Result[Stats, String] uses net, io, clock, threads {
        let cfg = self.cfg
        let ls = self.ls
        let stop = match poll.waker() {
            Ok(w) => w
            Err(e) => {
                fd.close(ls)
                return Err(e)
            }
        }
        // the stop signal: for the acceptor a waker that is woken once and never drained, so its
        // wait sees it from then on; for the connections `Live` (a flag, and a parker each: a
        // connection is woken out of its wait by `unpark`, and sees the flag between requests)
        let stopper = tok.child()
        let st = stopper
        let sw = stop
        let sh = self.sh
        let lv = sh.live
        let watcher = spawn(|| -> i32 {
            st.wait(time.never())
            live_stop(lv)
            poll.wake(sw)
            0
        })
        // `workers` slots: a connection holds one while it is served
        let slots: chan.Channel[bool] = chan.bounded(cfg.workers)
        for i in 0..cfg.workers { let z = slots.try_send(true) }
        let done: chan.Channel[i64] = chan.unbounded()
        let mut conns: Map[i64, Task[i32]] = Map.new()
        let mut next: i64 = 1
        let mut running = true
        while running {
            // either the listener has connections or the stop signal has come
            let mut accept_now = false
            match fd.wait_ready2(ls, fd.READY_READ, stop.r, fd.READY_READ, time.never()) {
                Ok(r) => {
                    if r.second != 0 { running = false }
                    if r.first != 0 { accept_now = true }
                }
                Err(e) => { running = false }
            }
            // on the stop, connections already in the backlog are still taken: they are
            // served if their request has arrived (and not reset by closing the listener)
            if accept_now || !running { accept_some(ls, stop, h, cfg, sh, slots, done, inout conns, inout next) }
        }
        fd.close(ls)
        // every connection still runs (and sees the stop); then the tasks end
        for t in conns.values() { let z = t.join() }
        stopper.cancel()
        let z = watcher.join()
        tok.detach(stopper)
        poll.close_waker(stop)
        // (the atomic cells of `Live` are not freed: `stats()` and `waiting()` read them after `serve`
        // returns, and a Server is made once per process, a few bytes)
        Ok(snapshot(sh))
    }
}

/// Joins the connection tasks that have finished (their ids are in `done`).
fn reap(done: chan.Channel[i64], inout conns: Map[i64, Task[i32]]) uses io {
    let mut going = true
    while going {
        match done.try_recv() {
            chan.Value(id) => {
                match conns.get(id) {
                    Some(t) => {
                        let gone = conns.remove(id)
                        let z = t.join()
                    }
                    None => {}
                }
            }
            chan.Empty => { going = false }
            chan.Closed => { going = false }
        }
    }
}

/// Accepts what is pending (at most 64 at a time, so a flood can't starve the stop check) and
/// starts a task for each connection: with a slot if one is free, else waiting for one if fewer
/// than `queue` connections wait, else answering 503.
fn accept_some(ls: i32, stop: poll.Waker, h: http.Handler, cfg: Config, sh: Hub, slots: chan.Channel[bool], done: chan.Channel[i64], inout conns: Map[i64, Task[i32]], inout next: i64) uses net, io, clock, threads {
    reap(done, inout conns)
    for k in 0..64 {
        match net.accept(ls, true) {
            Ok(Some(a)) => {
                let c = a.fd
                let peer = net.text(a.peer)
                let nd = net.set_option(c, net.NODELAY, 1)
                let admitted = match slots.try_recv() {
                    chan.Value(v) => true
                    chan.Empty => false
                    chan.Closed => false
                }
                if !admitted && waiting(sh) >= cfg.queue as i64 {
                    bump(sh, 1)
                    reject(c, cfg)
                } else {
                    if !admitted { bump(sh, 5) }
                    bump(sh, 0)
                    let id = next
                    next += 1
                    let t = spawn(|| -> i32 {
                        serve_conn(c, peer, h, cfg, sh, slots, admitted, done, id)
                        0
                    })
                    conns.insert(id, t)
                }
            }
            Ok(None) => { return }
            Err(e) => {
                // ECONNABORTED and friends: the next one may be fine; EMFILE: back off a
                // little (the stop signal ends the wait early)
                let z = fd.wait_ready(stop.r, fd.READY_READ, time.after_ms(20))
                return
            }
        }
    }
}

/// 503 without reading anything (best effort: the socket's send buffer is empty).
fn reject(c: i32, cfg: Config) uses net, io, clock {
    if cfg.secure.is_some() {
        // a TLS port: a plain 503 is garbage to a client that starts with a ClientHello
        fd.close(c)
        return
    }
    let mut r = http.error_response(503)
    r.set_header("Retry-After", sys.lit("1"))
    match http.write_response(r, false, false, date_of(cfg)) {
        Ok(b) => {
            let z = net.send(c, b)
        }
        Err(e) => {}
    }
    sock.linger_close(c, time.after_ms(100))
}

fn date_of(cfg: Config) -> List[u8] uses clock {
    if !cfg.date { return List.new() }
    http.imf_date(time.unix_seconds())
}

/// Whether the stop has come: one atomic load (no system call; a request checks it).
fn stop_signalled(sig: Sig) -> bool { sig.flag.load(atomic.Acquire) != 0 }

/// What a wait on a connection ended with.
type Wake = | Readable | TimedOut | Stopped | Failed

/// Waits for the connection `t` to be readable (over TLS: or to hold decrypted bytes already), the stop
/// (the connection's parker is unparked: `Stopped`, and the flag is set), or `dl`. The stop is one
/// unpark and its permit is taken by the wait that sees it, so a caller that goes on waiting is
/// not woken again for it (it reads `stop_signalled` when it needs to know).
fn wait_conn(t: transport.Transport, sig: Sig, dl: time.Deadline) -> Wake uses io, clock {
    if t.is_secure() && t.ready_to_read() {
        // decrypted bytes are waiting: the socket may be quiet; the stop is seen at the next wait
        // and by the check before the handler
        return Readable
    }
    match fd.wait_ready_or_unpark(t.fd, fd.READY_READ, sig.pk, dl) {
        Ok(fd.FdReady) => Readable
        Ok(fd.Unparked) => Stopped
        Ok(fd.DeadlinePassed) => TimedOut
        Err(e) => Failed
    }
}

/// Answers a refused request (the connection is closed after it).
fn refuse(t: transport.Transport, status: i32, cfg: Config) uses net, io, clock {
    match http.write_response(http.error_response(status), false, false, date_of(cfg)) {
        Ok(b) => {
            let sent = t.send_by(b, time.after(cfg.write_timeout))
        }
        Err(e) => {}
    }
}

fn log_trap(cfg: Config, method: List[u8], path: List[u8], why: String) uses io, clock {
    match cfg.log {
        Some(lg) => lg.error("handler trapped", middleware.trap_fields(method, path, why))
        None => {}
    }
}

/// What a guarded call gave: the response, and whether a trap was contained to make it.
type Answer = { resp: http.Response, trapped: bool }

/// Calls `h` with a trap contained: a trap is a 500 with the standard text, logged and counted.
fn guarded(h: http.Handler, req: http.Request, cfg: Config, sh: Hub) -> Answer uses io, clock {
    match task.catch(|| -> http.Response { h(req) }) {
        Ok(r) => Answer(r, false)
        Err(why) => {
            bump(sh, 7)
            log_trap(cfg, req.method, req.path, why)
            Answer(http.error_response(500), true)
        }
    }
}

/// The limits for decoding a request's transfer coding: the route's body limit unless
/// `Config.decode_max` says another.
fn decode_limits(cfg: Config, req: http.Request) -> compression.Limits {
    let mut n = cfg.decode_max.copy()
    if n == 0 {
        let pl = cfg.plan
        n = pl(req.method, req.path).max_body
        if n == 0 { n = cfg.limits.max_body }
    }
    compression.limit_output(n as u64)
}

fn is_head(m: List[u8]) -> bool { m.len() == 4 && m[0] == 72 && m[1] == 69 && m[2] == 65 && m[3] == 68 }

/// The parser of a connection while a handler reads a streamed request body through it.
type Link = { parser: parse.Parser }

fn earlier(a: time.Deadline, b: time.Deadline) -> time.Deadline {
    if a.at_ns < b.at_ns { return a }
    b
}

/// The next bytes of a streamed request body, at most `max`, waiting for the client no longer
/// than `dl` and `read_timeout` (empty: the body is complete). Holds the connection's parser
/// (`l`); reads the socket when the parser has nothing to give.
fn pull_once(inout l: Link, max: usize, dl: time.Deadline, t: transport.Transport, sig: Sig, cfg: Config) -> Result[List[u8], stream.Error] uses net, io, clock {
    let limit = earlier(dl, time.after(cfg.read_timeout))
    while true {
        match l.parser.body_next(max) {
            parse.Data(b) => { return Ok(b) }
            parse.End => { return Ok(List.new()) }
            parse.Broken(st, why) => {
                return Err(stream.error_text(stream.InvalidData, sys.to_string(why)))
            }
            parse.Wait => {
                if l.parser.wants_continue() {
                    l.parser.continue_sent()
                    let cont = sys.lit("HTTP/1.1 100 Continue\r\n\r\n")
                    if !t.send_by(cont, time.after(cfg.write_timeout)) { return Err(stream.error(stream.BrokenPipe, "the client went away")) }
                }
                match wait_conn(t, sig, limit) {
                    Readable => {
                        match t.try_recv(65536) {
                            Ok(Some(b)) => {
                                if b.len() == 0 {
                                    let z = l.parser.eof()
                                    return Err(stream.error(stream.UnexpectedEof, "the client closed the connection before the end of the body"))
                                }
                                l.parser.feed(b)
                            }
                            Ok(None) => {}
                            Err(e) => { return Err(stream.error_text(stream.Other, e)) }
                        }
                    }
                    TimedOut => { return Err(stream.error(stream.TimedOut, "timed out waiting for the request body")) }
                    // the server is stopping: the body already on its way is still read
                    Stopped => {}
                    Failed => { return Err(stream.error(stream.Other, "poll failed")) }
                }
            }
        }
    }
    Err(stream.error(stream.Other, "unreachable"))
}

fn body_pull(link: sync.Lock[Link], t: transport.Transport, sig: Sig, cfg: Config) -> http.Pull uses net, io, clock {
    |max: usize, dl: time.Deadline| -> Result[List[u8], stream.Error] {
        link.modify(|inout l: Link| -> Result[List[u8], stream.Error] { pull_once(inout l, max, dl, t, sig, cfg) })
    }
}

/// Reads and drops the rest of a streamed body: whether it ended cleanly.
fn drain_body(link: sync.Lock[Link], t: transport.Transport, sig: Sig, cfg: Config) -> bool uses net, io, clock {
    link.modify(|inout l: Link| -> bool {
        while true {
            match pull_once(inout l, 65536, time.after(cfg.read_timeout), t, sig, cfg) {
                Ok(b) => {
                    if b.len() == 0 { return true }
                }
                Err(e) => { return false }
            }
        }
        false
    })
}

fn closed_err() -> stream.Error { stream.error(stream.BrokenPipe, "the connection is closed") }

/// Sends a streamed response (`http.Stream`): the head, then `run` with a Duplex on the
/// connection. Returns what ends the connection (0 keep serving, 1 lingering close, 2 close now).
/// `left` is what the parser read beyond the request (for an upgrade: the first bytes the
/// client sent after its handshake).
fn run_stream(t: transport.Transport, sig: Sig, resp: http.Response, stm: http.Stream, keep: bool, left: List[u8], cfg: Config, sh: Hub, method: List[u8], path: List[u8]) -> i32 uses net, io, clock {
    let head = match http.write_stream_head(resp, stm.raw, keep, date_of(cfg)) {
        Ok(b) => b
        Err(e) => { return 2 }
    }
    if !t.send_by(head, time.after(cfg.write_timeout)) { return 2 }
    let pending = sync.lock(left)
    let raw = stm.raw
    let recv = |max: usize, dl: time.Deadline| -> Result[List[u8], stream.Error] {
        let early = pending.modify(|inout b: List[u8]| -> List[u8] {
            if b.len() == 0 { return List.new() }
            let n = if b.len() < max { b.len() } else { max }
            let out = bytes.slice(b, 0, n)
            b = bytes.slice(b, n, b.len())
            out
        })
        if early.len() > 0 { return Ok(early) }
        if !raw { return Err(stream.error(stream.Unsupported, "a chunked response has nothing to read")) }
        while true {
            match wait_conn(t, sig, dl) {
                Readable => {
                    match t.try_recv(max as i64) {
                        Ok(Some(b)) => { return Ok(b) }
                        Ok(None) => {}
                        Err(e) => { return Err(stream.error_text(stream.Other, e)) }
                    }
                }
                TimedOut => { return Err(stream.error(stream.TimedOut, "timed out")) }
                Stopped => {
                    return Err(stream.error(stream.Interrupted, "the server is stopping"))
                }
                Failed => { return Err(stream.error(stream.Other, "poll failed")) }
            }
        }
        Err(closed_err())
    }
    let send = |data: List[u8]| -> Result[(), stream.Error] {
        if data.len() == 0 { return Ok(()) }
        let wire = if raw { data } else { http.chunk(data) }
        if t.send_by(wire, time.after(cfg.write_timeout)) { return Ok(()) }
        Err(closed_err())
    }
    let stopping = || -> bool { stop_signalled(sig) }
    let run = stm.run
    let dx = http.Duplex(recv, send, stopping)
    match task.catch(|| -> () { run(dx) }) {
        Ok(z) => {}
        Err(why) => {
            // the head is sent: the response can't become a 500, the connection is dropped
            bump(sh, 7)
            log_trap(cfg, method, path, why)
            return 2
        }
    }
    if raw { return 1 }
    if !t.send_by(sys.lit("0\r\n\r\n"), time.after(cfg.write_timeout)) { return 2 }
    if keep { return 0 }
    1
}

/// A connection's task: waits for a slot if it was accepted without one, serves the connection,
/// gives the slot back and tells the acceptor it is done (so its Task can be joined).
fn serve_conn(c: i32, peer: List[u8], h: http.Handler, cfg: Config, sh: Hub, slots: chan.Channel[bool], admitted: bool, done: chan.Channel[i64], id: i64) uses net, io, clock, threads {
    if !admitted {
        // accepted while every slot was taken: wait for one (the acceptor counted this
        // connection as waiting, so at most `queue` of them are parked here)
        let got = slots.recv(time.never())
        bump(sh, 6)
    }
    // the connection's parker: the stop unparks it (`Live`); it is in no list once it left
    let pk = sync.parker()
    live_join(sh.live, id, pk)
    let sig = Sig(sh.live.flag, pk)
    match cfg.secure {
        None => { serve_slot(transport.plain(c), peer, h, cfg, sig, sh) }
        Some(acc) => {
            // the TLS handshake: it holds this slot (so a connection that stalls in it is bounded by the
            // acceptor's deadline) and blocks this task only
            let go = acc.accept
            match go(c) {
                Ok(t) => { serve_slot(t, peer, h, cfg, sig, sh) }
                Err(why) => {
                    bump(sh, 8)
                    fd.close(c)
                }
            }
        }
    }
    live_leave(sh.live, id)
    pk.close()
    let back = slots.try_send(true)
    let fin = done.try_send(id)
}

/// A connection that speaks HTTP/2: http/h2 reads and writes it (`pre` is what was read before it was known to be
/// HTTP/2), and every request stream calls `h` as an HTTP/1.1 request would (a trap is contained and counted as
/// there). The server stopping ends the connection gracefully (GOAWAY, then once its streams are done).
fn serve_h2(t: transport.Transport, pre: List[u8], peer: List[u8], h: http.Handler, cfg: Config, opt: h2.Options, sig: Sig, sh: Hub) uses net, io, clock, threads {
    let mut ctx: List[http.Header] = List.new()
    match t.sec {
        Some(sc) => {
            ctx.push(http.Header(sys.lit("tls"), sc.suite.bytes()))
            if sc.peer_certs.len() > 0 { ctx.push(http.Header(sys.lit("tls_client_cert"), sc.peer_certs[0].copy())) }
        }
        None => {}
    }
    let counted = |r: http.Request| -> http.Response {
        bump(sh, 2)
        let ans = guarded(h, r, cfg, sh)
        ans.resp
    }
    let wire = h2.wire_with_prefix(h2.wire_of_transport(t), pre)
    let stopping = || -> bool { stop_signalled(sig) }
    let base = h2.handler(counted, peer, ctx)
    let top = match cfg.h2_wrap {
        Some(w) => w(base)
        None => base
    }
    let r = h2.serve_until(wire, opt, top, stopping)
}

/// One connection, request after request (see the module comment), with its slot held. Owns
/// `c`; `peer` is the client's address as text (it goes in every Request).
fn serve_slot(t: transport.Transport, peer: List[u8], h: http.Handler, cfg: Config, sig: Sig, sh: Hub) uses net, io, clock, threads {
    let mut ok = true
    let mut stopping = false
    let mut parser = parse.requests(cfg.limits)
    parser.set_plan(cfg.plan)
    let mut served: u32 = 0
    // the Date header text, made again when the second changes
    let mut date_at: i64 = -1
    let mut date_txt: List[u8] = List.new()
    // what ends the connection: 0 keep going, 1 close after a response (a lingering
    // close), 2 close now
    let mut end = 0
    if !ok { end = 2 }
    match cfg.h2 {
        Some(h2o) => {
            // HTTP/2 is on: a connection that negotiated `h2`, or whose first bytes are the HTTP/2 preface
            // ("PRI * HTTP/2.0": not a request HTTP/1.1 accepts), is served by http/h2
            let mut is_h2 = http.eq_s(t.alpn(), "h2")
            let mut pre: List[u8] = List.new()
            if !is_h2 {
                let dl0 = time.after(cfg.idle_timeout)
                while pre.len() < 4 && end == 0 {
                    match wait_conn(t, sig, dl0) {
                        Readable => {
                            match t.try_recv(65536) {
                                Ok(Some(b)) => {
                                    if b.len() == 0 { end = 2 } else { pre.extend(b) }
                                }
                                Ok(None) => {}
                                Err(e) => { end = 2 }
                            }
                        }
                        TimedOut => { end = 2 }
                        Stopped => { end = 2 }
                        Failed => { end = 2 }
                    }
                }
                if end == 0 && pre.len() >= 4 && pre[0] == 80 && pre[1] == 82 && pre[2] == 73 && pre[3] == 32 { is_h2 = true }
            }
            if end == 0 && is_h2 {
                serve_h2(t, pre, peer, h, cfg, h2o, sig, sh)
                return
            }
            if end == 0 { parser.feed(pre) }
        }
        None => {}
    }
    if end == 2 { t.close_now() }
    while end == 0 {
        // read one request
        let mut started = !parser.idle()
        let mut dl = if started { time.after(cfg.read_timeout) } else { time.after(cfg.idle_timeout) }
        let mut got: Option[parse.Msg] = None
        while end == 0 && got.is_none() {
            match parser.next() {
                parse.Done(m) => { got = Some(m) }
                parse.Bad(status, why) => {
                    bump(sh, 3)
                    refuse(t, status, cfg)
                    end = 1
                }
                parse.More => {
                    if parser.wants_continue() {
                        parser.continue_sent()
                        let cont = sys.lit("HTTP/1.1 100 Continue\r\n\r\n")
                        if !t.send_by(cont, time.after(cfg.write_timeout)) { end = 2 }
                    }
                    if end == 0 && stopping && parser.idle() {
                        // shutting down: serve a request only if it has already arrived
                        match t.try_recv(65536) {
                            Ok(Some(b)) => {
                                if b.len() == 0 { end = 2 } else { parser.feed(b) }
                            }
                            Ok(None) => { end = 2 }
                            Err(e) => { end = 2 }
                        }
                        if end == 0 && !started {
                            started = true
                            dl = time.after(cfg.read_timeout)
                        }
                    } else if end == 0 {
                        match wait_conn(t, sig, dl) {
                            Readable => {
                                match t.try_recv(65536) {
                                    Ok(Some(b)) => {
                                        if b.len() == 0 {
                                            // the peer closed (or half-closed) its side
                                            if parser.idle() {
                                                end = 2
                                            } else {
                                                match parser.eof() {
                                                    parse.Done(m) => { got = Some(m) }
                                                    parse.Bad(status, why) => {
                                                        bump(sh, 3)
                                                        refuse(t, status, cfg)
                                                        end = 1
                                                    }
                                                    parse.More => { end = 2 }
                                                }
                                            }
                                        } else {
                                            parser.feed(b)
                                            if !started {
                                                started = true
                                                dl = time.after(cfg.read_timeout)
                                            }
                                        }
                                    }
                                    Ok(None) => {}
                                    Err(e) => { end = 2 }
                                }
                            }
                            TimedOut => {
                                if started {
                                    bump(sh, 4)
                                    refuse(t, 408, cfg)
                                    end = 1
                                } else {
                                    end = 2
                                }
                            }
                            Stopped => {
                                stopping = true
                                        }
                            Failed => { end = 2 }
                        }
                    }
                }
            }
        }
        if end != 0 { break }
        let m = got.unwrap()
        // handle it
        served += 1
        bump(sh, 2)
        let streaming_req = m.streaming
        let mut req = parse.to_request(m)
        req.peer = peer
        match t.sec {
            Some(sc) => {
                // the handler can tell https (`tls`: the cipher suite) and see who the client proved to be
                // (`tls_client_cert`: the leaf certificate, DER, when client authentication is on)
                req.set_ctx("tls", sc.suite.bytes())
                if sc.peer_certs.len() > 0 { req.set_ctx("tls_client_cert", sc.peer_certs[0].copy()) }
            }
            None => {}
        }
        let head_only = is_head(req.method)
        let mut trapped = false
        let call_method = req.method.copy()
        let call_path = req.path.copy()
        // `stopping` is what the last wait saw; the stop may have come after it, while the
        // rest of this request was read (a wait that saw only data, then a read that got the
        // bytes sent after the stop too), so the signal is checked again here: a request in
        // flight at the stop is answered with `Connection: close`
        if !stopping && stop_signalled(sig) { stopping = true }
        let mut keep = req.keep_alive && served < cfg.max_requests && !stopping && waiting(sh) == 0
        let mut resp = http.response(500)
        // a transfer coding (`gzip, chunked`) is undone before the handler sees the request
        let mut refused: Option[http.Response] = None
        // (only a transfer coding is undone here, so a request without a Transfer-Encoding is as it is)
        if http.find_s(req.headers, "transfer-encoding").is_some() {
            match compress.decode_request(req, true, decode_limits(cfg, req)) {
                Ok(r) => { req = r }
                Err(r) => {
                    refused = Some(r)
                    bump(sh, 3)
                }
            }
        }
        if refused.is_some() {
            resp = refused.unwrap()
            keep = false
        } else if streaming_req {
            // the body is read by the handler as it goes: the parser is shared with the reader
            let link = sync.lock(Link(parser.copy()))
            req.stream = Some(http.Body(body_pull(link, t, sig, cfg)))
            let ans = guarded(h, req, cfg, sh)
            resp = ans.resp
            trapped = ans.trapped
            if trapped {
                // the handler may have died holding the body's lock (it would never come
                // back): the body is not drained and the connection closes after the 500
                keep = false
            } else {
                // what the handler left unread is read and dropped; a body that can't be
                // finished ends the connection after the response
                if !drain_body(link, t, sig, cfg) { keep = false }
                parser = link.get().parser.copy()
            }
        } else {
            let ans = guarded(h, req, cfg, sh)
            resp = ans.resp
            trapped = ans.trapped
            if trapped { keep = false }
        }
        match resp.stream {
            Some(stm) => {
                if head_only {
                    let mut hr = resp.copy()
                    hr.stream = None
                    hr.body = List.new()
                    resp = hr
                } else {
                    let left = bytes.slice(parser.buf, parser.pos, parser.buf.len())
                    end = run_stream(t, sig, resp, stm, keep, left, cfg, sh, call_method, call_path)
                    if end == 0 { resp.keep_alive = true }
                    if end != 0 { break }
                    continue
                }
            }
            None => {}
        }
        if cfg.date {
            let now_s = time.unix_seconds()
            if now_s != date_at {
                date_at = now_s
                date_txt = http.imf_date(now_s)
            }
        }
        let out = match http.write_response(resp, head_only, keep, date_txt) {
            Ok(b) => b
            Err(e) => http.write_response(http.error_response(500), head_only, false, date_txt).unwrap()
        }
        if !t.send_by(out, time.after(cfg.write_timeout)) {
            bump(sh, 4)
            end = 2
        } else if !keep || !resp.keep_alive {
            end = 1
        }
    }
    if end == 1 { t.linger_close(time.after_ms(1000)) }
    if end == 2 { t.close_now() }
}
