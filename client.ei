//! http/client: a minimal blocking HTTP/1.1 client with deadlines: for tests, tools and
//! calling other services. A `Conn` is one connection at a time to one address, kept alive
//! between requests while the server allows it; when the server (or `close`) ended it, the
//! next request connects again. Every call takes a time.Deadline that bounds the whole
//! exchange (connecting, sending, reading the response).
//!
//! Host names (eider-lang#59): `connect_host(name, port, dl)`, `fetch_host`, `get_host`, `post_host`
//! take a host name, an IPv4 address or an IPv6 address (without brackets). A name is resolved
//! with `net.lookup_by` before the deadline (the resolver runs on a thread of its own and
//! the caller waits only until `dl`); the addresses are tried in the resolver's order, each
//! attempt getting an equal share of the time left, so one that black-holes does not use it
//! all. An address literal never asks the resolver. A `Conn` made from a name resolves it
//! again when it must reconnect, so a long-lived `Conn` follows DNS changes. The `Host`
//! header is the name (and the port unless it is 80); a name that could not be a host name
//! (control bytes, spaces, `/`, `@`, `#`, `?`, non-ASCII, over 253 bytes) is refused before
//! anything is sent or resolved.
//!
//! Not here yet (docs/services.md "Next steps"): TLS (C3: use a proxy), connection pools,
//! redirects, automatic retries (a request on a reused connection that the server had
//! already closed fails with Err; send it again on a new Conn if it is idempotent), streaming
//! bodies, and happy-eyeballs (addresses are tried one after the other).

import core.sys
import std.bytes
import std.fd
import std.net
import std.time
import http
import http.parse
import http.sock

/// A connection to `addr`. `host` is what goes in the Host header ("127.0.0.1:8080");
/// `open` says whether a connection is up now.
pub type Conn = { fd: i32, addr: net.Addr, host: List[u8], lim: http.Limits, parser: parse.Parser, open: bool, name: List[u8], port: i32 }

/// Connects to `a` before `dl` (non-blocking connect, then a wait for it).
pub fn connect(a: net.Addr, dl: time.Deadline) -> Result[Conn, String] uses net, io, clock {
    connect_with(a, http.limits(), dl)
}

/// `connect`, with limits on the responses it will read.
pub fn connect_with(a: net.Addr, lim: http.Limits, dl: time.Deadline) -> Result[Conn, String] uses net, io, clock {
    let s = dial(a, dl)?
    Ok(Conn(s, a, net.text(a), lim, parse.responses(lim), true, List.new(), 0))
}

fn dial(a: net.Addr, dl: time.Deadline) -> Result[i32, String] uses net, io, clock {
    let s = net.socket(a.family, net.STREAM, true)?
    match finish_connect(s, a, dl) {
        Ok(b) => {}
        Err(e) => {
            fd.close(s)
            return Err(e)
        }
    }
    let z = net.set_option(s, net.NODELAY, 1)
    Ok(s)
}

fn finish_connect(s: i32, a: net.Addr, dl: time.Deadline) -> Result[bool, String] uses net, io, clock {
    if net.connect(s, a)? { return Ok(true) }
    if !fd.wait_ready(s, fd.READY_WRITE, dl)? { return Err(String.from("connect: deadline exceeded")) }
    net.connect_result(s)
}

impl Conn {
    /// Sends `req` and reads its response (skipping 1xx interim responses), connecting
    /// first if no connection is up. The connection is closed afterwards when either side
    /// asked for it. On Err the connection is closed too (its state is unknown).
    fn request(inout self, req: http.Request, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
        if !self.open {
            if self.name.len() > 0 {
                // made from a name: ask again, the address may have changed
                let s = connect_name(self.name, self.port, dl)?
                self.fd = s.fd
                self.addr = s.addr
            } else {
                self.fd = dial(self.addr, dl)?
            }
            self.parser = parse.responses(self.lim)
            self.open = true
        }
        let wire = http.write_request(req, self.host, req.keep_alive)?
        if !sock.send_by(self.fd, wire, dl) {
            self.close()
            return Err(String.from("send: deadline exceeded or connection closed"))
        }
        let head = req.method.len() == 4 && bytes.eq(req.method, sys.lit("HEAD"))
        while true {
            if head { self.parser.expect_no_body() }
            match self.read_one(dl) {
                Ok(r) => {
                    if r.status >= 100 && r.status < 200 && r.status != 101 { continue }
                    if !r.keep_alive || !req.keep_alive { self.close() }
                    return Ok(r)
                }
                Err(e) => {
                    self.close()
                    return Err(e)
                }
            }
        }
        Err(String.from("unreachable"))
    }

    fn read_one(inout self, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
        while true {
            match self.parser.next() {
                parse.Done(m) => { return Ok(parse.to_response(m)) }
                parse.Bad(st, why) => { return Err(bad(why)) }
                parse.More => {}
            }
            if !fd.wait_ready(self.fd, fd.READY_READ, dl)? { return Err(String.from("response: deadline exceeded")) }
            match net.try_recv(self.fd, 65536)? {
                Some(b) => {
                    if b.len() == 0 {
                        match self.parser.eof() {
                            parse.Done(m) => { return Ok(parse.to_response(m)) }
                            parse.Bad(st, why) => { return Err(bad(why)) }
                            parse.More => { return Err(String.from("connection closed before a response")) }
                        }
                    }
                    self.parser.feed(b)
                }
                None => {}
            }
        }
        Err(String.from("unreachable"))
    }

    /// Closes the connection (idempotent).
    fn close(inout self) uses io {
        if self.open {
            fd.close(self.fd)
            self.open = false
        }
    }
}

fn bad(why: List[u8]) -> String {
    let mut m = String.from("invalid response: ")
    m.append(sys.to_string(why))
    m
}

/// One request on a new connection, closed afterwards.
pub fn fetch(a: net.Addr, req: http.Request, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    let mut c = connect(a, dl)?
    let mut r = req.copy()
    r.keep_alive = false
    let resp = c.request(r, dl)
    c.close()
    resp
}

/// GET `target` (one-shot).
pub fn get(a: net.Addr, target: str, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    fetch(a, http.request("GET", sys.lit(target)), dl)
}

/// POST `body` with `content_type` to `target` (one-shot).
pub fn post(a: net.Addr, target: str, content_type: str, body: List[u8], dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    let mut r = http.request("POST", sys.lit(target))
    r.set_header("Content-Type", sys.lit(content_type))
    r.body = body
    fetch(a, r, dl)
}

// ---- host names

/// Whether `h` can be a host: 1 to 253 bytes of letters, digits, `-`, `_`, `.`, or an IPv6
/// address (hex digits and colons, with dots for an IPv4 tail). Nothing else: not a space, a
/// control byte, `/`, `@`, `#`, `?`, `[`, `]`, `%` (a zone id), or a non-ASCII byte.
pub fn valid_host(h: List[u8]) -> bool {
    if h.len() == 0 || h.len() > 253 { return false }
    for c in h {
        let ok = bytes.is_alpha(c) || bytes.is_digit(c) || c == 45 || c == 95 || c == 46 || c == 58
        if !ok { return false }
    }
    true
}

type Dialed = { fd: i32, addr: net.Addr }

/// The host as the Host header writes it: `name`, `name:port`, `[v6]:port`.
fn host_header(name: List[u8], port: i32) -> List[u8] {
    let mut out: List[u8] = List.new()
    let v6 = bytes.find_byte(name, 58, 0).is_some()
    if v6 { out.push(91) }
    bytes.append(inout out, name)
    if v6 { out.push(93) }
    if port != 80 {
        out.push(58)
        bytes.append(inout out, bytes.from_u64(port as u64))
    }
    out
}

/// The addresses of `name` (a literal is itself; a name is looked up before `dl`).
pub fn resolve(name: List[u8], port: i32, dl: time.Deadline) -> Result[List[net.Addr], String] uses net, io, clock {
    if !valid_host(name) { return Err(String.from("not a valid host name")) }
    if port < 1 || port > 65535 { return Err(String.from("not a valid port")) }
    match net.parse(name, port) {
        Ok(a) => {
            let mut one: List[net.Addr] = List.new()
            one.push(a)
            return Ok(one)
        }
        Err(e) => {}
    }
    // a colon means an IPv6 literal, and it did not parse
    if bytes.find_byte(name, 58, 0).is_some() { return Err(String.from("not a valid host name")) }
    let found = net.lookup_by(name, bytes.from_u64(port as u64), 0, net.STREAM, dl)?
    if found.len() == 0 { return Err(String.from("no address for the host name")) }
    Ok(found)
}

/// Resolves `name` and connects to the first address that accepts before `dl`: each attempt
/// may use an equal share of the time left.
fn connect_name(name: List[u8], port: i32, dl: time.Deadline) -> Result[Dialed, String] uses net, io, clock {
    let addrs = resolve(name, port, dl)?
    let mut last = String.from("no address")
    let mut i: usize = 0
    for a in addrs {
        let left = addrs.len() - i
        i += 1
        let share = time.after(time.nanos(dl.remaining().as_ns() / (left as i64)))
        let attempt = if left == 1 { dl } else { share.earlier(dl) }
        match dial(a, attempt) {
            Ok(s) => { return Ok(Dialed(s, a)) }
            Err(e) => { last = e }
        }
    }
    Err(last)
}

/// Connects to `name:port` (a host name, or an IPv4/IPv6 address) before `dl`; see the module
/// comment.
pub fn connect_host(name: str, port: i32, dl: time.Deadline) -> Result[Conn, String] uses net, io, clock {
    connect_host_with(name, port, http.limits(), dl)
}

/// `connect_host`, with limits on the responses it will read.
pub fn connect_host_with(name: str, port: i32, lim: http.Limits, dl: time.Deadline) -> Result[Conn, String] uses net, io, clock {
    let n = sys.lit(name)
    let d = connect_name(n, port, dl)?
    // an address literal is reconnected without the resolver; a name is resolved again
    let literal = net.parse(n, port).is_ok()
    Ok(Conn(d.fd, d.addr, host_header(n, port), lim, parse.responses(lim), true, if literal { List.new() } else { n }, port))
}

/// One request to `name:port` on a new connection, closed afterwards.
pub fn fetch_host(name: str, port: i32, req: http.Request, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    let mut c = connect_host(name, port, dl)?
    let mut r = req.copy()
    r.keep_alive = false
    let resp = c.request(r, dl)
    c.close()
    resp
}

/// GET `target` from `name:port` (one-shot).
pub fn get_host(name: str, port: i32, target: str, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    fetch_host(name, port, http.request("GET", sys.lit(target)), dl)
}

/// POST `body` with `content_type` to `target` on `name:port` (one-shot).
pub fn post_host(name: str, port: i32, target: str, content_type: str, body: List[u8], dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    let mut r = http.request("POST", sys.lit(target))
    r.set_header("Content-Type", sys.lit(content_type))
    r.body = body
    fetch_host(name, port, r, dl)
}
