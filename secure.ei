//! http/secure: TLS 1.3 for the server, the client and WebSocket, over eider-tls. This is the one
//! module that imports it (and, through it, the crypto package); http/server, http/client and
//! http/ws only know `transport.Transport`, so a program that does not import `http.secure` loads no
//! TLS code (docs/services.md "TLS").
//!
//! Server:
//!
//!     let tls = secure.server_from_files(String.from("chain.pem"), String.from("key.pem")).unwrap()      // leaf first
//!         .with_client_auth_pem(ca_pem, true).unwrap()                           // optional mTLS
//!     let o = service.options().with_tls(tls.acceptor())
//!     service.run(net.ipv4(0, 0, 0, 0, 8443), r, o)
//!
//! A handshake that is not finished `handshake_timeout` (default 10 s) after the connection took its
//! worker slot is dropped, and at most `max_handshakes` (default 128) run at once: the others wait for a
//! place within the same deadline. The minimum (and only) protocol version is TLS 1.3, ALPN offers
//! `http/1.1`. The certificate can be replaced while serving (`reload`, `reload_files`): connections
//! accepted afterwards use it, the ones open keep theirs.
//!
//! Client:
//!
//!     let tls = secure.client_system().unwrap()                  // verifies against the system's CA bundle
//!     let mut c = secure.connect_url("https://example.org/".bytes(), tls, dl).unwrap()
//!     let r = c.request(http.request("GET", "/"), dl)
//!
//! The certificate is verified (chain, validity, key usage, and the host name against the SAN entries; no
//! CN fallback) for the host of the URL, which is also sent as SNI. `client_roots_pem(pem)` trusts exactly
//! those roots; `client_insecure_skip_verify_for_tests()` verifies nothing and is for tests only. `wss`:
//! `dial_ws`. Redirects are not followed (http/client does not follow any).

import core.sys
import std.bytes
import std.chan
import std.fs
import std.stream
import std.sync
import std.time
import std.net
import tls.alert
import tls.client as tlsclient
import tls.server as tlsserver
import tls.config
import tls.conn
import tls.keyfile
import tls.pem
import tls.suite
import tls.x509
import http
import http.client
import http.transport
import http.ws

fn text_of(e: alert.Error) -> String {
    let mut s = String.from("")
    e.show(inout s)
    s
}

/// A TLS session on a socket as the functions http needs from it (http/transport).
pub fn wrap(c: conn.Conn[stream.Fd]) -> transport.Secure uses io, clock {
    let alpn = match c.negotiated_alpn() {
        Some(a) => a
        None => List.new()
    }
    let name = String.from(suite.name(c.cipher_suite()))
    let certs = c.peer_certificates()
    let lk = sync.lock(c)
    transport.Secure(
        || -> bool { lk.modify(|inout x: conn.Conn[stream.Fd]| -> bool x.ready_to_read()) },
        |max: usize| -> Result[Option[List[u8]], String] {
            lk.modify(|inout x: conn.Conn[stream.Fd]| -> Result[Option[List[u8]], String] {
                match x.try_recv(max) {
                    Ok(v) => Ok(v)
                    Err(e) => Err(text_of(e))
                }
            })
        },
        |data: List[u8], dl: time.Deadline| -> bool {
            lk.modify(|inout x: conn.Conn[stream.Fd]| -> bool {
                match x.send_by(data, dl) {
                    Ok(_) => true
                    Err(e) => false
                }
            })
        },
        |ms: i64| -> () {
            lk.modify(|inout x: conn.Conn[stream.Fd]| -> () {
                let z = x.close_by(time.after_ms(ms))
            })
        },
        alpn, name, certs)
}

// ---- the server

/// What a TLS server is configured with. Make one with `server_from_files`, `server_from_pem`,
/// `server_from_der` or `server(identity)`, change it with the `with_...` methods, and take its
/// `acceptor()`.
pub type ServerTls = {
    identity: config.Identity,
    client_auth: config.ClientAuth,
    handshake_timeout: time.Duration,
    max_handshakes: usize
}

/// A server with `identity` (certificate chain, leaf first, and its private key; eider-tls' `config.identity_from_pem`),
/// no client certificates, a 10 s handshake deadline and at most 128 handshakes at once.
pub fn server(identity: config.Identity) -> ServerTls {
    ServerTls(identity, config.NoClientAuth, time.seconds(10), 128)
}

/// From the PEM text of the chain (every CERTIFICATE block, leaf first) and of the private key (PKCS#8, SEC1 or
/// PKCS#1; Ed25519, P-256, P-384 and RSA 2048 to 8192 bits). Err if the key is not the first certificate's.
pub fn server_from_pem(chain_pem: List[u8], key_pem: List[u8]) -> Result[ServerTls, String] {
    Ok(server(config.identity_from_pem(chain_pem, key_pem)?))
}

/// From two PEM files.
pub fn server_from_files(chain_path: String, key_path: String) -> Result[ServerTls, String] uses fs {
    Ok(server(config.identity_from_files(chain_path, key_path)?))
}

/// From DER: the certificates (leaf first) and the private key (PKCS#8, SEC1 or PKCS#1, found by trying each).
pub fn server_from_der(chain: List[List[u8]], key_der: List[u8]) -> Result[ServerTls, String] {
    let mut chain_pem: List[u8] = List.new()
    for c in chain { bytes.append(inout chain_pem, pem.encode("CERTIFICATE", c)) }
    let label = if keyfile.from_pkcs8(key_der).is_ok() {
        "PRIVATE KEY"
    } else if keyfile.from_sec1(key_der).is_ok() {
        "EC PRIVATE KEY"
    } else if keyfile.from_pkcs1(key_der).is_ok() {
        "RSA PRIVATE KEY"
    } else {
        return Err(String.from("secure: the private key DER is not PKCS#8, SEC1 or PKCS#1"))
    }
    server_from_pem(chain_pem, pem.encode(label, key_der))
}

impl ServerTls {
    /// Asks clients for a certificate that chains to a root in `ca_pem` (`required`: refuse those that send none).
    /// The handler sees the leaf as the request context `tls_client_cert` (DER).
    fn with_client_auth_pem(self, ca_pem: List[u8], required: bool) -> Result[ServerTls, String] {
        let roots = x509.store_from_pem(ca_pem)?
        if roots.roots.len() == 0 { return Err(String.from("secure: no certificate in the client CA PEM")) }
        let ca = if required { config.RequireClientAuth(roots) } else { config.RequestClientAuth(roots) }
        Ok(ServerTls(self.identity, ca, self.handshake_timeout, self.max_handshakes))
    }

    /// How long a connection has for the whole handshake, from the moment it took a worker slot (also the wait
    /// for a place among the concurrent handshakes).
    fn with_handshake_timeout(self, d: time.Duration) -> ServerTls {
        ServerTls(self.identity, self.client_auth, d, self.max_handshakes)
    }

    /// At most `n` (at least 1) handshakes at the same time; a connection waits for its turn within its handshake deadline.
    fn with_max_handshakes(self, n: usize) -> ServerTls {
        ServerTls(self.identity, self.client_auth, self.handshake_timeout, if n == 0 { 1 } else { n })
    }

    /// What `service.Options.with_tls` and `server.Config.secure` take.
    fn acceptor(self) -> transport.Acceptor uses io, clock {
        let mut cfg = config.server_config(self.identity)
        cfg.alpn.push("http/1.1".bytes())
        cfg.client_auth = self.client_auth
        let cell = sync.lock(cfg)
        let permits: chan.Channel[bool] = chan.bounded(self.max_handshakes)
        for i in 0..self.max_handshakes { let z = permits.try_send(true) }
        let timeout = self.handshake_timeout
        transport.Acceptor(
            |fd: i32| -> Result[transport.Transport, String] {
                let dl = time.after(timeout)
                match permits.recv(dl) {
                    chan.Value(v) => {}
                    chan.Empty => { return Err(String.from("secure: too many handshakes in progress")) }
                    chan.Closed => { return Err(String.from("secure: closed")) }
                }
                let c = cell.get()
                let r = tlsserver.accept(stream.fd(fd), c, dl)
                let back = permits.try_send(true)
                match r {
                    Ok(conn) => Ok(transport.Transport(fd, Some(wrap(conn))))
                    Err(e) => Err(text_of(e))
                }
            },
            |chain_pem: List[u8], key_pem: List[u8]| -> Result[(), String] {
                let id = config.identity_from_pem(chain_pem, key_pem)?
                cell.modify(|inout c: config.ServerConfig| -> () { c.identity = id })
                Ok(())
            })
    }
}

/// Replaces the certificate of a running server (its `Acceptor`, from `ServerTls.acceptor`) with PEM text: the connections
/// accepted afterwards use it. Err (and nothing changes) if the PEM is not a chain and a key that go together.
pub fn reload(a: transport.Acceptor, chain_pem: List[u8], key_pem: List[u8]) -> Result[(), String] {
    let f = a.reload
    f(chain_pem, key_pem)
}

/// `reload` from two files (a certificate renewed on disk, on SIGHUP or on a timer of the program's choosing).
pub fn reload_files(a: transport.Acceptor, chain_path: String, key_path: String) -> Result[(), String] uses fs {
    let c = fs.read(chain_path.bytes())?
    let k = fs.read(key_path.bytes())?
    reload(a, c, k)
}

// ---- the client

/// What an https client trusts. `client_system()`, `client_roots_pem(pem)` or the test-only
/// `client_insecure_skip_verify_for_tests()`.
pub type ClientTls = {
    roots: x509.Store,
    verify: config.Verify,
    identity: Option[config.Identity]
}

/// Verifies servers against the operating system's CA bundle (`/etc/pki/tls/certs/ca-bundle.crt`, `/etc/ssl/certs/ca-certificates.crt`, ...; read once, here).
pub fn client_system() -> Result[ClientTls, String] uses fs {
    Ok(ClientTls(x509.system_store()?, config.Full, None))
}

/// Verifies servers against exactly the roots in `roots_pem`.
pub fn client_roots_pem(roots_pem: List[u8]) -> Result[ClientTls, String] {
    let st = x509.store_from_pem(roots_pem)?
    if st.roots.len() == 0 { return Err(String.from("secure: no certificate in the roots PEM")) }
    Ok(ClientTls(st, config.Full, None))
}

/// Verifies nothing about the server's certificate: any server, including an attacker in the middle, is accepted
/// (the handshake's own signatures are still checked). FOR TESTS ONLY; never reachable from `client_system` or
/// `client_roots_pem`.
pub fn client_insecure_skip_verify_for_tests() -> ClientTls {
    ClientTls(x509.empty_store(), config.Insecure, None)
}

impl ClientTls {
    /// Sends `identity` (see eider-tls' `config.identity_from_pem`) when the server asks for a client certificate.
    fn with_identity(self, identity: config.Identity) -> ClientTls {
        ClientTls(self.roots, self.verify, Some(identity))
    }

    /// The handshake for connections to `name` (verified against it and sent as SNI), for `client.connect_host_secure`.
    fn connector(self, name: List[u8]) -> transport.Connector uses io, clock {
        let tls = self
        |fd: i32, dl: time.Deadline| -> Result[transport.Secure, String] {
            let mut cfg = config.client_config("", tls.roots)
            cfg.server_name = Some(name)
            cfg.verify = tls.verify
            cfg.identity = tls.identity
            cfg.alpn.push("http/1.1".bytes())
            match tlsclient.connect(stream.fd(fd), cfg, dl) {
                Ok(c) => Ok(wrap(c))
                Err(e) => Err(text_of(e))
            }
        }
    }
}

/// Connects to `name:port` over TLS before `dl` (TCP and the handshake together).
pub fn connect_host(name: str, port: i32, tls: ClientTls, dl: time.Deadline) -> Result[client.Conn, String] uses net, io, clock {
    connect_host_with(name, port, tls, http.limits(), dl)
}

/// `connect_host`, with limits on the responses it will read.
pub fn connect_host_with(name: str, port: i32, tls: ClientTls, lim: http.Limits, dl: time.Deadline) -> Result[client.Conn, String] uses net, io, clock {
    let n = sys.lit(name)
    client.connect_bytes(n, port, lim, Some(tls.connector(n)), dl)
}

/// A URL split for the client.
pub type Url = { secure: bool, ws: bool, host: List[u8], port: i32, target: List[u8] }

/// Splits (`url` is bytes: `"https://...".bytes()` or `sys.lit(...)`) `http://`, `https://`, `ws://` or `wss://` URLs: host (a name, IPv4 or `[IPv6]`), optional port (80/443
/// by scheme), and the rest as the request target (`/` when empty). No user info, no fragment.
pub fn parse_url(b: List[u8]) -> Result[Url, String] {
    let mut rest: List[u8] = List.new()
    let mut secure = false
    let mut isws = false
    if bytes.starts_with(b, sys.lit("https://")) { secure = true; rest = bytes.slice(b, 8, b.len()) }
    else if bytes.starts_with(b, sys.lit("http://")) { rest = bytes.slice(b, 7, b.len()) }
    else if bytes.starts_with(b, sys.lit("wss://")) { secure = true; isws = true; rest = bytes.slice(b, 6, b.len()) }
    else if bytes.starts_with(b, sys.lit("ws://")) { isws = true; rest = bytes.slice(b, 5, b.len()) }
    else { return Err(String.from("secure: the URL must start with http://, https://, ws:// or wss://")) }
    let mut end = rest.len()
    for i in 0..rest.len() {
        let ch = rest[i]
        if end == rest.len() && (ch == 47 || ch == 63 || ch == 35) { end = i }
    }
    let auth = bytes.slice(rest, 0, end)
    let mut target = bytes.slice(rest, end, rest.len())
    if target.len() == 0 || target[0] != 47 {
        let mut t: List[u8] = List.new()
        t.push(47)
        bytes.append(inout t, target)
        target = t
    }
    for ch in target { if ch == 35 || ch <= 32 || ch == 127 { return Err(String.from("secure: the URL has a fragment or a control byte")) } }
    if bytes.find_byte(auth, 64, 0).is_some() { return Err(String.from("secure: user info in a URL is not supported")) }
    let mut host = auth.copy()
    let mut port: i32 = if secure { 443 } else { 80 }
    if auth.len() > 0 && auth[0] == 91 {
        // [IPv6] or [IPv6]:port
        match bytes.find_byte(auth, 93, 0) {
            Some(close) => {
                host = bytes.slice(auth, 1, close)
                if close + 1 < auth.len() {
                    if auth[close + 1] != 58 { return Err(String.from("secure: bad URL authority")) }
                    port = port_of(bytes.slice(auth, close + 2, auth.len()))?
                }
            }
            None => { return Err(String.from("secure: bad URL authority")) }
        }
    } else {
        match bytes.find_byte(auth, 58, 0) {
            Some(colon) => {
                host = bytes.slice(auth, 0, colon)
                port = port_of(bytes.slice(auth, colon + 1, auth.len()))?
            }
            None => {}
        }
    }
    if !client.valid_host(host) { return Err(String.from("secure: not a valid host in the URL")) }
    Ok(Url(secure, isws, host, port, target))
}

fn port_of(p: List[u8]) -> Result[i32, String] {
    if p.len() == 0 || p.len() > 5 { return Err(String.from("secure: bad port in the URL")) }
    let mut n: i32 = 0
    for ch in p {
        if !bytes.is_digit(ch) { return Err(String.from("secure: bad port in the URL")) }
        n = n * 10 + ((ch - 48) as i32)
    }
    if n < 1 || n > 65535 { return Err(String.from("secure: bad port in the URL")) }
    Ok(n)
}

/// Connects to the host of `url`: TLS for `https` and `wss` (verified as `tls` says), plain TCP for `http` and `ws`.
/// The request is yours: `c.request(http.request("GET", target), dl)`.
pub fn connect_url(url: List[u8], tls: ClientTls, dl: time.Deadline) -> Result[client.Conn, String] uses net, io, clock {
    connect_url_with(url, tls, http.limits(), dl)
}

/// `connect_url`, with limits on the responses it will read.
pub fn connect_url_with(url: List[u8], tls: ClientTls, lim: http.Limits, dl: time.Deadline) -> Result[client.Conn, String] uses net, io, clock {
    let u = parse_url(url)?
    if u.secure { return client.connect_bytes(u.host, u.port, lim, Some(tls.connector(u.host)), dl) }
    client.connect_bytes(u.host, u.port, lim, None, dl)
}

/// One GET of `url` on a new connection, closed afterwards. A redirect answer is returned as it is.
pub fn get_url(url: List[u8], tls: ClientTls, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    let u = parse_url(url)?
    let mut c = connect_url(url, tls, dl)?
    let mut r = http.request("GET", u.target)
    r.keep_alive = false
    let resp = c.request(r, dl)
    c.close()
    resp
}

/// A WebSocket client for `wss://` (TLS) or `ws://` URLs, handshake included.
pub fn dial_ws(url: List[u8], tls: ClientTls, protocols: List[List[u8]], dl: time.Deadline) -> Result[ws.Client, String] uses net, io, clock {
    let u = parse_url(url)?
    let c = connect_url(url, tls, dl)?
    ws.dial_conn(c, u.target, protocols, dl)
}
