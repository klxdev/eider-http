// http/health and http/service: probes, the drain flag, the default layers in order, rate
// limiting that exempts the probes, forwarded headers from untrusted peers, and a real server
// that turns readiness 503 on the stop signal but keeps serving through the drain delay.

import core.sys
import std.bytes
import std.io
import logging
import std.net
import std.task
import std.time
import http
import http.client
import http.server
import http.router
import http.health
import http.proxy
import http.ratelimit
import http.service
import http.testing

fn lit(s: str) -> List[u8] { sys.lit(s) }

fn has(s: List[u8], n: str) -> bool { bytes.find(s, lit(n), 0).is_some() }

fn quiet() -> service.Options { service.options().without_logs() }

fn app() -> router.Router {
    var r = router.new()
    r.get("/hello", |q: http.Request| -> http.Response { http.text(200, "hello") })
    r.get("/who", |q: http.Request| -> http.Response { http.respond(200, "text/plain", q.peer) })
    r
}

fn show(r: http.Response) uses io {
    var l = bytes.from_i64(r.status as i64)
    l.push(32)
    bytes.append(inout l, r.header("content-type").unwrap_or(lit("-")))
    l.push(32)
    bytes.append(inout l, r.body)
    io.outln(l)
}

fn main() uses io, net, clock, threads, fs {
    print("-- probes")
    let hl = health.new().check("db", || -> Result[(), String] { Ok(()) }).check("cache", || -> Result[(), String] { Err(String.from("redis://user:hunter2@10.0.0.9: refused")) }).check("odd name!", || -> Result[(), String] {
        panic("check trapped")
        Ok(())
    })
    var r = router.new()
    hl.mount(inout r)
    let c = testing.client(router.handler(r))
    show(c.get("/healthz"))
    show(c.get("/readyz"))
    let ok = health.new().check("db", || -> Result[(), String] { Ok(()) })
    var r2 = router.new()
    ok.mount(inout r2)
    let c2 = testing.client(router.handler(r2))
    show(c2.get("/readyz"))
    io.outln(c2.get("/readyz").header("cache-control").unwrap())
    ok.drain()
    print(ok.draining())
    show(c2.get("/readyz"))
    show(c2.get("/healthz"))
    print(health.new().draining())

    print("-- the default layers")
    let o = quiet()
    let h = service.handler(app(), o)
    let t = testing.client(h).from_peer("203.0.113.9:1000")
    show(t.get("/hello"))
    let rid = t.get("/hello").header("x-request-id")
    print(rid.is_some())
    show(t.get("/nope"))
    show(t.get("/healthz"))
    show(t.get("/readyz"))
    let mt = t.get("/metrics")
    print(has(mt.body, "http_requests_total{{method=\"GET\",route=\"/hello\",code=\"200\"}} 2"))
    print(has(mt.body, "code=\"404\"}} 1"))
    print(has(mt.body, "http_ratelimit_allowed_total"))
    // a client's own X-Request-Id is kept, a hostile one replaced
    io.outln(t.with_header("X-Request-Id", "abc-1").get("/hello").header("x-request-id").unwrap())
    print(t.with_header("X-Request-Id", "bad id").get("/hello").header("x-request-id").unwrap() != lit("bad id"))
    // profiling is not there unless asked for
    show(t.get("/debug/heap"))

    print("-- forwarded headers are not trusted by default")
    let who = testing.client(service.handler(app(), quiet())).from_peer("203.0.113.9:1000").with_header("X-Forwarded-For", "198.51.100.7")
    io.outln(who.get("/who").body)
    let trusted = quiet().with_trust(proxy.trust_none().allow("10.0.0.0/8").unwrap())
    let via = testing.client(service.handler(app(), trusted)).from_peer("10.1.2.3:1000").with_header("X-Forwarded-For", "198.51.100.7")
    io.outln(via.get("/who").body)
    let direct = testing.client(service.handler(app(), trusted)).from_peer("203.0.113.9:1000").with_header("X-Forwarded-For", "198.51.100.7")
    io.outln(direct.get("/who").body)

    print("-- rate limiting, probes exempt")
    let lo = quiet().with_limit(ratelimit.new(1, time.seconds(1), 3))
    let lc = testing.client(service.handler(app(), lo)).from_peer("203.0.113.9:1000")
    var codes: List[i32] = List.new()
    for i in 0..6 { codes.push(lc.get("/hello").status) }
    print(codes)
    print(lc.get("/healthz").status)
    print(lc.get("/readyz").status)
    print(lc.get("/metrics").status)
    let limited = lc.get("/hello")
    show(limited)
    print(limited.header("retry-after").is_some())
    let off = quiet().no_rate_limit()
    let oc = testing.client(service.handler(app(), off)).from_peer("203.0.113.9:1000")
    var n429 = 0
    for i in 0..3000 { if oc.get("/hello").status == 429 { n429 += 1 } }
    print(n429)

    print("-- draining a real server")
    let dh = health.new()
    let od = quiet().with_health(dh).with_drain_delay(time.millis(600))
    let srv = server.listen(net.ipv4(127, 0, 0, 1, 0), od.server).unwrap()
    let hh = service.handler(app(), od)
    let stop = task.root()
    let st = stop
    let th = spawn(|| -> server.Stats { service.serve(srv, hh, od, st).unwrap() })
    let a = srv.addr()
    let dl = time.after_ms(20000)
    print(client.get(a, "/readyz", dl).unwrap().status)
    print(client.get(a, "/hello", dl).unwrap().status)
    stop.cancel()
    // readiness turns 503 first ...
    var flipped = false
    while !flipped && !dl.expired() {
        if client.get(a, "/readyz", dl).unwrap().status == 503 { flipped = true }
    }
    print(flipped)
    // ... and the server still answers during the delay
    print(client.get(a, "/hello", dl).unwrap().status)
    print(client.get(a, "/healthz", dl).unwrap().status)
    let stats = th.join()
    print(stats.requests >= 5)
    match client.get(a, "/hello", dl) {
        Ok(x) => print("still serving?")
        Err(e) => print(bytes.ends_with(e.bytes(), lit("Connection refused")))
    }
}
