-- boundary-like text in the content
prefix of a longer line
[a] ct=text/plain body=before\r\n--XXYZ and --X and\r\n--XX-x\r\n--XX \x09q\r\nafter
end
same, split everywhere
[a] ct=text/plain body=before\r\n--XXYZ and --X and\r\n--XX-x\r\n--XX \x09q\r\nafter
end
bare LF and CR in content
[a] ct=text/plain body=x\r\n--X
end
binary content
[a] file=b ct=application/octet-stream body=\x00\xff\r\x00\n-
end
a one-character boundary that is common text
[x] ct=text/plain body=--a--a
end
-- headers
filename* wins, quotes and backslashes
[a"b\c] file=\xe2\x82\xac rates.txt ct=Text/CSV; charset=utf-8 body=d
end
filename*=ISO-8859-1
[a] file=caf\xc3\xa9.txt ct=application/octet-stream body=d
end
bad filename* falls back
[a] file=f.txt ct=application/octet-stream body=d
end
Windows path is kept as sent
[a] file=C:\Users\me\a.txt ct=application/octet-stream body=d
end
a ; inside a quoted filename
[a;b] file=x;y.txt ct=application/octet-stream body=d
end
no content-type: field
[a] ct=text/plain body=d
end
duplicate names kept in order
[a] ct=text/plain body=1
[a] ct=text/plain body=2
end
