// http/jwt: RFC 7515 Appendix A.1 and the jwt.io HS256 vectors, tokens signed by OpenSSL (RS256,
// RS384, PS256, ES256, ES384, EdDSA) and by python's hmac (HS256, HS512) and verified here, signing
// round trips, JWKS, and the negatives: tampering, `none`, algorithm confusion, expiry, wrong
// issuer or audience, unknown kid, crit, duplicated members, padding, size.

import core.sys
import std.bytes
import std.encoding
import std.io
import crypto
import http.jwt

fn lit(s: str) -> List[u8] { sys.lit(s) }

fn now() -> i64 { 1800000000 }

fn show(label: str, r: Result[jwt.Claims, jwt.Error]) uses io { show_b(lit(label), r) }

fn c_rsa(n: List[u8], e: List[u8]) -> crypto.RsaPublic { crypto.rsa_public_from_ne(n, e).unwrap() }
fn c_rsa_priv(der: List[u8]) -> crypto.RsaPrivate { crypto.rsa_private_from_der(der).unwrap() }
fn c_ec(p256: bool, d: List[u8]) -> crypto.EcSecret { crypto.ec_secret(if p256 { crypto.P256 } else { crypto.P384 }, d).unwrap() }
fn c_seed(b: List[u8]) -> crypto.Ed25519Seed { crypto.ed25519_seed(b).unwrap() }
fn c_hmac(key: List[u8], msg: List[u8]) -> List[u8] { crypto.hmac(crypto.hmac_key(crypto.Sha256, key), msg).unwrap().bytes }

fn show_b(label: List[u8], r: Result[jwt.Claims, jwt.Error]) uses io {
    let mut l = label.copy()
    bytes.append(inout l, lit(": "))
    match r {
        Ok(c) => {
            bytes.append(inout l, lit("ok alg="))
            bytes.append(inout l, lit(jwt.alg_name(c.alg)))
            match c.subject() {
                Some(s) => {
                    bytes.append(inout l, lit(" sub="))
                    bytes.append(inout l, s)
                }
                None => {}
            }
        }
        Err(e) => { bytes.append(inout l, jwt.error_text(e).bytes()) }
    }
    io.outln(l)
}

fn secret() -> List[u8] { lit("0123456789abcdef0123456789abcdef-secret") }

fn hs_keys() -> jwt.KeySet { jwt.keyset().add("hs1", jwt.Secret(secret())) }

fn mk(payload: str) -> List[u8] uses io {
    jwt.sign(jwt.HS256, jwt.SecretKey(secret()), lit("hs1"), lit(payload)).unwrap()
}

fn hs_only() -> jwt.Validation { jwt.validation(List[jwt.HS256]) }

fn flip(t: str, at: usize) -> List[u8] {
    let mut b = lit(t)
    b[at] = if b[at] == 65 { 66 } else { 65 }
    b
}

fn jwks() -> List[u8] {
    let mut s = lit(r#"{"keys":["#)
    bytes.append(inout s, lit(r#"{"kty":"RSA","kid":"rsa1","use":"sig","n":"rr8oaFKmhr2YbccRwVyPWCAUq2vS75lD-Ch-IaMwQu_Rjy-sBXz2AVdz_9Eg68z3UyNwC6vPD_b0OtLQF4dJUoyzrNvdloIrE3MD-R3YjkzhuFUK_URD4-uMYNt1rruYwHv5-g0ZRGDTcTLn3_IjfGK2U89JvcZT5SUyV7De1rT7_0WR5mW22_Dcd94AqnPEFHC5myqEK7OdCKn1Gf3WcLxpWXr8eWJQoZQQB1dIjmdZOm2KDSHYCDVVvCpbHFzOBCCOB5530xxGwfzjenF7c9jE_dd3kWuGvQIJ4wb5v-AxhqcDFdEpThoNrLVsKA3jxIGqLvPBlma2Vsej012HaQ","e":"AQAB"},"#))
    bytes.append(inout s, lit(r#"{"kty":"EC","kid":"p256","crv":"P-256","x":"1vdEuIpt9FUUxjLzu2f0N7XvY_3OneTKit2uIEIKcbg","y":"YdEFjiwSUvT1OnATeyiwmnijAaje7H2RExxVGSAb28Q"},"#))
    bytes.append(inout s, lit(r#"{"kty":"EC","kid":"p384","crv":"P-384","x":"Oobl0IQM0je-7ssFl4uHC9XyWDl7HYsqFyRJ-gWT6L1tvN9sXFDYJQtAOLWddfNv","y":"I3ed4lTcsI2wOoxztMoNB10uZjY8-9RfnI7XVk5QkV1dDNGLBlotGk0MLzyULOYl"},"#))
    bytes.append(inout s, lit(r#"{"kty":"OKP","kid":"ed1","crv":"Ed25519","x":"9CXLv09olMOQ0Ls7MkfQbaO8lpns2eEzEUZyaqDyS4o"},"#))
    bytes.append(inout s, lit(r#"{"kty":"EC","kid":"p521","crv":"P-521","x":"AA","y":"AA"},"#))
    bytes.append(inout s, lit(r#"{"kty":"RSA","kid":"encrypting","use":"enc","n":"AQAB","e":"AQAB"},"#))
    bytes.append(inout s, lit(r#"{"kty":"oct","kid":"hs1","k":"MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYtc2VjcmV0"}"#))
    bytes.append(inout s, lit(r#"]}"#))
    s
}

fn all_algs() -> List[jwt.Alg] {
    List[jwt.HS256, jwt.HS384, jwt.HS512, jwt.RS256, jwt.RS384, jwt.RS512, jwt.PS256, jwt.PS384, jwt.PS512, jwt.ES256, jwt.ES384, jwt.EdDSA]
}

fn main() uses io, clock {
    io.outln(lit("-- RFC 7515 A.1 (HS256)"))
    let k = lit("AyM1SysPpbyDfgZld3umj1qzKObwVMkoqQ-EstJQLr_T-1qS0gZH75aKtMN3Yj0iPS4hcgUuTwjAzZr1Z9CAow")
    let keys = jwt.keyset().add("", jwt.Secret(encoding.unbase64_url(k).unwrap()))
    let a1 = lit("eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")
    let mut va = jwt.validation(List[jwt.HS256])
    show("a1 before exp", jwt.verify_at(va, keys, a1, 1300819379))
    show("a1 at exp", jwt.verify_at(va, keys, a1, 1300819380))
    va.leeway = 5
    show("a1 at exp, leeway 5", jwt.verify_at(va, keys, a1, 1300819384))
    show("a1 past exp + leeway", jwt.verify_at(va, keys, a1, 1300819385))
    va.leeway = 0
    va.issuer = Some(lit("joe"))
    show("a1 issuer joe", jwt.verify_at(va, keys, a1, 1300819379))
    va.issuer = Some(lit("jane"))
    show("a1 issuer jane", jwt.verify_at(va, keys, a1, 1300819379))
    match jwt.verify_at(jwt.validation(List[jwt.HS256]), keys, a1, 1300819379) {
        Ok(c) => {
            match c.issuer() { Some(i) => io.outln(i), None => {} }
            io.outln(bytes.from_u64(c.raw.len() as u64))
        }
        Err(_) => {}
    }

    io.outln(lit("-- jwt.io HS256"))
    let jio = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
    let jk = jwt.keyset().add("", jwt.Secret(lit("your-256-bit-secret")))
    let mut vj = jwt.validation(List[jwt.HS256])
    vj.require_exp = false
    show("jwt.io", jwt.verify_at(vj, jk, lit(jio), now()))
    vj.require_exp = true
    show("jwt.io needs exp", jwt.verify_at(vj, jk, lit(jio), now()))
    vj.require_exp = false
    let payload = lit(r#"{"sub":"1234567890","name":"John Doe","iat":1516239022}"#)
    let again = jwt.sign(jwt.HS256, jwt.SecretKey(lit("your-256-bit-secret")), List.new(), payload).unwrap()
    io.outln(again)
    print(bytes.eq(again, lit(jio)))

    io.outln(lit("-- tampering"))
    show("flipped payload", jwt.verify_at(vj, jk, flip(jio, 60), now()))
    show("flipped signature", jwt.verify_at(vj, jk, flip(jio, 130), now()))
    show("flipped header", jwt.verify_at(vj, jk, flip(jio, 10), now()))
    show("wrong secret", jwt.verify_at(vj, jwt.keyset().add("", jwt.Secret(lit("your-257-bit-secret"))), lit(jio), now()))
    show("truncated signature", jwt.verify_at(vj, jk, lit("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5"), now()))
    show("two parts", jwt.verify_at(vj, jk, lit("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0"), now()))
    show("four parts", jwt.verify_at(vj, jk, lit("a.b.c.d"), now()))
    show("empty", jwt.verify_at(vj, jk, List.new(), now()))
    show("empty signature", jwt.verify_at(vj, jk, lit("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0."), now()))
    show("padded base64", jwt.verify_at(vj, jk, lit("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9==.eyJzdWIiOiIxMjM0NTY3ODkwIn0.x"), now()))
    show("garbage", jwt.verify_at(vj, jk, lit("not.a.jwt"), now()))
    let mut tiny = jwt.validation(List[jwt.HS256])
    tiny.max_size = 100
    show("too large", jwt.verify_at(tiny, jk, lit(jio), now()))

    io.outln(lit("-- alg none and friends"))
    let nh = encoding.base64_url(lit(r#"{"alg":"none"}"#))
    let np = encoding.base64_url(lit(r#"{"sub":"root","exp":4102444800}"#))
    let mut none_tok = nh.bytes()
    none_tok.push(46)
    bytes.append(inout none_tok, np.bytes())
    let mut none_sig = none_tok.copy()
    none_tok.push(46)
    show("none, no signature", jwt.verify_at(jwt.validation(List[jwt.HS256]), jk, none_tok, now()))
    bytes.append(inout none_sig, lit(".c2ln"))
    show("none, with a signature", jwt.verify_at(jwt.validation(List[jwt.HS256]), jk, none_sig, now()))
    let mut vnone = jwt.validation(List[jwt.HS256])
    vnone.require_exp = false
    for name in ["None", "NONE", "nOnE", "hs256", "ES512", "HS256 ", ""] {
        let mut hh = lit(r#"{"alg":""#)
        bytes.append(inout hh, lit(name))
        bytes.append(inout hh, lit(r#""}"#))
        let mut t = encoding.base64_url(hh).bytes()
        t.push(46)
        bytes.append(inout t, np.bytes())
        bytes.append(inout t, lit(".c2ln"))
        let mut l = lit("alg ")
        bytes.append(inout l, lit(name))
        show_b(l, jwt.verify_at(vnone, jk, t, now()))
    }
    print(jwt.alg_of(lit("none")).is_none())
    print(jwt.alg_of(lit("ES512")).is_none())
    print(jwt.alg_of(lit("ES256")).is_some())

    io.outln(lit("-- algorithm confusion"))
    let rsa_n = encoding.unbase64_url(lit("rr8oaFKmhr2YbccRwVyPWCAUq2vS75lD-Ch-IaMwQu_Rjy-sBXz2AVdz_9Eg68z3UyNwC6vPD_b0OtLQF4dJUoyzrNvdloIrE3MD-R3YjkzhuFUK_URD4-uMYNt1rruYwHv5-g0ZRGDTcTLn3_IjfGK2U89JvcZT5SUyV7De1rT7_0WR5mW22_Dcd94AqnPEFHC5myqEK7OdCKn1Gf3WcLxpWXr8eWJQoZQQB1dIjmdZOm2KDSHYCDVVvCpbHFzOBCCOB5530xxGwfzjenF7c9jE_dd3kWuGvQIJ4wb5v-AxhqcDFdEpThoNrLVsKA3jxIGqLvPBlma2Vsej012HaQ")).unwrap()
    let rsa_e = encoding.unbase64_url(lit("AQAB")).unwrap()
    let rsa_pub = jwt.Rsa(c_rsa(rsa_n, rsa_e))
    let rkeys = jwt.keyset().add("rsa1", rsa_pub)
    let both = jwt.validation(List[jwt.RS256, jwt.HS256])
    // the classic attack: an HS256 token MACed with the RSA key's public bytes as the secret
    let forged = jwt.sign(jwt.HS256, jwt.SecretKey(rsa_n), lit("rsa1"), lit(r#"{"sub":"admin","exp":4102444800}"#)).unwrap()
    show("HS256 with the RSA modulus as the secret, HS256 allowed", jwt.verify_at(both, rkeys, forged, now()))
    show("the same, only RS256 allowed", jwt.verify_at(jwt.validation(List[jwt.RS256]), rkeys, forged, now()))
    show("RS256 token, kid rsa1 names a secret", jwt.verify_at(jwt.validation(List[jwt.RS256]), jwt.keyset().add("rsa1", jwt.Secret(rsa_n)), lit("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InJzYTEifQ.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwic3ViIjoiYWRhIiwiYXVkIjpbImFwaSIsIm90aGVyIl0sInNjb3BlIjoicmVhZCB3cml0ZSIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwfQ.RecsaKBcKh4bjaNH8TLj1fjLAHLBmOLxdj3FBNS628LhWUads6OZSkgv1geOoZPRHJ1b2AVZ5p5cZAJw85XMwQQY7E9gX0cRaQGMtIKTyjdGbHjMJB8Z131MtCX_RPaeboNWGeWrNGWTozmU98D_fDecvDdSaxLzkOgUqObgiFrKObDNKuUVAOiAwYNLpBDuxwZb_DzLwUQ-RH0GPPB4FTt5Lz24e5R0ZouH_1sgtvPSp6WyXjKpFHPCHQljDZltgfkxx870ewKPT_gSusb5kFSS53yEuA4PLR9aCJnzZvHsxP9i5b4oXwje6t-jJAB409bmXcfzmH0jGHfipMpmSA"), now()))
    show("RS256 token, only HS256 allowed", jwt.verify_at(hs_only(), rkeys, lit("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InJzYTEifQ.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwic3ViIjoiYWRhIiwiYXVkIjpbImFwaSIsIm90aGVyIl0sInNjb3BlIjoicmVhZCB3cml0ZSIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwfQ.RecsaKBcKh4bjaNH8TLj1fjLAHLBmOLxdj3FBNS628LhWUads6OZSkgv1geOoZPRHJ1b2AVZ5p5cZAJw85XMwQQY7E9gX0cRaQGMtIKTyjdGbHjMJB8Z131MtCX_RPaeboNWGeWrNGWTozmU98D_fDecvDdSaxLzkOgUqObgiFrKObDNKuUVAOiAwYNLpBDuxwZb_DzLwUQ-RH0GPPB4FTt5Lz24e5R0ZouH_1sgtvPSp6WyXjKpFHPCHQljDZltgfkxx870ewKPT_gSusb5kFSS53yEuA4PLR9aCJnzZvHsxP9i5b4oXwje6t-jJAB409bmXcfzmH0jGHfipMpmSA"), now()))
    show("RS256 token as PS256 (not allowed)", jwt.verify_at(jwt.validation(List[jwt.PS256]), rkeys, lit("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InJzYTEifQ.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwic3ViIjoiYWRhIiwiYXVkIjpbImFwaSIsIm90aGVyIl0sInNjb3BlIjoicmVhZCB3cml0ZSIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwfQ.RecsaKBcKh4bjaNH8TLj1fjLAHLBmOLxdj3FBNS628LhWUads6OZSkgv1geOoZPRHJ1b2AVZ5p5cZAJw85XMwQQY7E9gX0cRaQGMtIKTyjdGbHjMJB8Z131MtCX_RPaeboNWGeWrNGWTozmU98D_fDecvDdSaxLzkOgUqObgiFrKObDNKuUVAOiAwYNLpBDuxwZb_DzLwUQ-RH0GPPB4FTt5Lz24e5R0ZouH_1sgtvPSp6WyXjKpFHPCHQljDZltgfkxx870ewKPT_gSusb5kFSS53yEuA4PLR9aCJnzZvHsxP9i5b4oXwje6t-jJAB409bmXcfzmH0jGHfipMpmSA"), now()))
    let pinned = jwt.keyset().add_for("rsa1", jwt.PS256, rsa_pub)
    show("key pinned to PS256, RS256 token", jwt.verify_at(jwt.validation(List[jwt.RS256, jwt.PS256]), pinned, lit("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InJzYTEifQ.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwic3ViIjoiYWRhIiwiYXVkIjpbImFwaSIsIm90aGVyIl0sInNjb3BlIjoicmVhZCB3cml0ZSIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwfQ.RecsaKBcKh4bjaNH8TLj1fjLAHLBmOLxdj3FBNS628LhWUads6OZSkgv1geOoZPRHJ1b2AVZ5p5cZAJw85XMwQQY7E9gX0cRaQGMtIKTyjdGbHjMJB8Z131MtCX_RPaeboNWGeWrNGWTozmU98D_fDecvDdSaxLzkOgUqObgiFrKObDNKuUVAOiAwYNLpBDuxwZb_DzLwUQ-RH0GPPB4FTt5Lz24e5R0ZouH_1sgtvPSp6WyXjKpFHPCHQljDZltgfkxx870ewKPT_gSusb5kFSS53yEuA4PLR9aCJnzZvHsxP9i5b4oXwje6t-jJAB409bmXcfzmH0jGHfipMpmSA"), now()))
    show("key pinned to PS256, PS256 token", jwt.verify_at(jwt.validation(List[jwt.RS256, jwt.PS256]), pinned, lit("eyJhbGciOiJQUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InJzYTEifQ.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwic3ViIjoiYWRhIiwiYXVkIjpbImFwaSIsIm90aGVyIl0sInNjb3BlIjoicmVhZCB3cml0ZSIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwfQ.njSt_lbqHB2JVoBaAcNtW2bkOyoz8bKNVkj_q-krdxcBnm7HW7wiLinlIHT_voo12ta_QIqj1TFH_404d0yfAf0Ud1eLY_uiYWJJnz2XSedbJyD79Z9qt-PuxgzHCgTFEh6WRXkHrS1ZnjKY1GrW3um1vdQ7K-W9-gMKbRFMZnVwF2VoFw2nj1Hq0il7w0Ks3nYeACv66tH3-Ajt6bLXdptYPqmHoQ8JlXnMjjUtQ-yTzhp9s6ZcnY8OLzQhPcooe4WFg45KB9AmM4oqFirtGk3vmtChl1H_lpVZFAPj7CZDmtkUjN_QC5iuml86Sisp_30b_8aTVjRYUBVOofHTgA"), now()))

    io.outln(lit("-- tokens from OpenSSL and python, keys from a JWKS"))
    let set = jwt.parse_jwks(jwks(), false).unwrap()
    io.outln(bytes.from_u64(set.len() as u64))
    let strict = jwt.validation(all_algs())
    show("RS256", jwt.verify_at(strict, set, lit("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InJzYTEifQ.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwic3ViIjoiYWRhIiwiYXVkIjpbImFwaSIsIm90aGVyIl0sInNjb3BlIjoicmVhZCB3cml0ZSIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwfQ.RecsaKBcKh4bjaNH8TLj1fjLAHLBmOLxdj3FBNS628LhWUads6OZSkgv1geOoZPRHJ1b2AVZ5p5cZAJw85XMwQQY7E9gX0cRaQGMtIKTyjdGbHjMJB8Z131MtCX_RPaeboNWGeWrNGWTozmU98D_fDecvDdSaxLzkOgUqObgiFrKObDNKuUVAOiAwYNLpBDuxwZb_DzLwUQ-RH0GPPB4FTt5Lz24e5R0ZouH_1sgtvPSp6WyXjKpFHPCHQljDZltgfkxx870ewKPT_gSusb5kFSS53yEuA4PLR9aCJnzZvHsxP9i5b4oXwje6t-jJAB409bmXcfzmH0jGHfipMpmSA"), now()))
    show("RS384", jwt.verify_at(strict, set, lit("eyJhbGciOiJSUzM4NCIsInR5cCI6IkpXVCIsImtpZCI6InJzYTEifQ.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwic3ViIjoiYWRhIiwiYXVkIjpbImFwaSIsIm90aGVyIl0sInNjb3BlIjoicmVhZCB3cml0ZSIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwfQ.TTczG8X0V2-DyRxc-jWw5XUmnhi3wMNluVSBzTh7RUvUP1JWrqy90LAZT5nLtJGGTTFd3yJHhkXEoBOQ11NOJjHpZfLjk9IkouunkGPxQy6no1RKB2TFKApbF3ZV97Am156kVOnMz8jtDiEeyjNcyA0E9vNRfAfagG9pz63rDgS0q9hEU0IrpeZcpKOCkHQqtJ8D7zWjFlyqZw_4_Vw9DLjfY9LbflzxgMd4e8vnyK3q02KKRQ0TEfYkxVFq0f_A1eFW5W7nE6V3wPce3wIaec342BP4csudQKQo8yrpp9D2UgDO6tlVAMj3UcrvGTNrOzpwzrs3neSA6hTY8j_q_A"), now()))
