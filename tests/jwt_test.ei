    io.outln(lit("-- exp, nbf, iat, aud, iss with HS256"))
    let hv = hs_only()
    show("fractional exp", jwt.verify_at(hv, hs_keys(), mk(r#"{"exp":1800000000.5}"#), 1799999999))
    show("fractional exp, then", jwt.verify_at(hv, hs_keys(), mk(r#"{"exp":1800000000.5}"#), 1800000000))
    show("exp as a string", jwt.verify_at(hv, hs_keys(), mk(r#"{"exp":"1900000000"}"#), now()))
    show("exp as a negative", jwt.verify_at(hv, hs_keys(), mk(r#"{"exp":-5}"#), now()))
    show("exp in exponent form", jwt.verify_at(hv, hs_keys(), mk(r#"{"exp":1.9e9}"#), now()))
    show("no exp", jwt.verify_at(hv, hs_keys(), mk(r#"{"sub":"x"}"#), now()))
    let mut noexp = hs_only()
    noexp.require_exp = false
    show("no exp, not required", jwt.verify_at(noexp, hs_keys(), mk(r#"{"sub":"x"}"#), now()))
    show("nbf in the future", jwt.verify_at(hv, hs_keys(), mk(r#"{"exp":1900000000,"nbf":1800000100}"#), now()))
    let mut lee = hs_only()
    lee.leeway = 100
    show("nbf in the future, leeway", jwt.verify_at(lee, hs_keys(), mk(r#"{"exp":1900000000,"nbf":1800000100}"#), now()))
    show("nbf reached", jwt.verify_at(hv, hs_keys(), mk(r#"{"exp":1900000000,"nbf":1800000000}"#), now()))
    let mut ia = hs_only()
    ia.audience = Some(lit("api"))
    ia.issuer = Some(lit("me"))
    show("aud string", jwt.verify_at(ia, hs_keys(), mk(r#"{"exp":1900000000,"aud":"api","iss":"me"}"#), now()))
    show("aud missing", jwt.verify_at(ia, hs_keys(), mk(r#"{"exp":1900000000,"iss":"me"}"#), now()))
    show("aud wrong", jwt.verify_at(ia, hs_keys(), mk(r#"{"exp":1900000000,"aud":"apis","iss":"me"}"#), now()))
    show("aud numbers", jwt.verify_at(ia, hs_keys(), mk(r#"{"exp":1900000000,"aud":[1,2],"iss":"me"}"#), now()))
    show("aud among many", jwt.verify_at(ia, hs_keys(), mk(r#"{"exp":1900000000,"aud":["x","api"],"iss":"me"}"#), now()))
    show("iss missing", jwt.verify_at(ia, hs_keys(), mk(r#"{"exp":1900000000,"aud":"api"}"#), now()))
    show("payload not an object", jwt.verify_at(hv, hs_keys(), mk("[1,2]"), now()))
    show("payload not JSON", jwt.verify_at(hv, hs_keys(), mk("nope"), now()))
    show("duplicate claim", jwt.verify_at(hv, hs_keys(), mk(r#"{"exp":1900000000,"exp":1}"#), now()))

    io.outln(lit("-- headers and keys"))
    let none_set = jwt.keyset()
    let ok = mk(r#"{"exp":1900000000,"sub":"u"}"#)
    show("kid hs1", jwt.verify_at(hv, hs_keys(), ok, now()))
    show("unknown kid", jwt.verify_at(hv, jwt.keyset().add("other", jwt.Secret(secret())), ok, now()))
    show("no keys", jwt.verify_at(hv, none_set, ok, now()))
    let two = jwt.keyset().add("a", jwt.Secret(lit("aaaa"))).add("hs1", jwt.Secret(secret()))
    show("two keys, kid picks", jwt.verify_at(hv, two, ok, now()))
    let nokid = jwt.sign(jwt.HS256, jwt.SecretKey(secret()), List.new(), lit(r#"{"exp":1900000000}"#)).unwrap()
    show("no kid, two keys", jwt.verify_at(hv, two, nokid, now()))
    show("no kid, one key", jwt.verify_at(hv, jwt.keyset().add("whatever", jwt.Secret(secret())), nokid, now()))
    // headers built by hand and signed with the secret
    for h in [r#"{"alg":"HS256","crit":["exp"],"exp":1}"#, r#"{"alg":"HS256","alg":"HS256"}"#, r#"{"alg":"HS256","kid":5}"#, r#"{"typ":"JWT"}"#, r#"{"alg":5}"#, r#"[]"#, r#"{"alg":"HS256","b64":false}"#, r#"{"alg":"HS256","typ":"JWT"}"#] {
        let mut t = encoding.base64_url(lit(h)).bytes()
        t.push(46)
        bytes.append(inout t, encoding.base64_url(lit(r#"{"exp":1900000000}"#)).bytes())
        let tag = c_hmac(secret(), t)
        t.push(46)
        bytes.append(inout t, encoding.base64_url(tag).bytes())
        show(h, jwt.verify_at(hv, jwt.keyset().add("", jwt.Secret(secret())), t, now()))
    }
    print(jwt.secret_strong(lit("short")).is_err())
    print(jwt.secret_strong(secret()).is_ok())
    print(jwt.key_allows(jwt.Secret(lit("")), jwt.HS256))
    print(jwt.key_allows(jwt.Secret(lit("k")), jwt.RS256))

    io.outln(lit("-- signing round trips"))
    let claims = jwt.claims().str("iss", lit("me")).str("sub", lit("a \"quoted\" name")).int("exp", 1900000000).strs("aud", List[lit("x"), lit("y")]).json()
    io.outln(claims)
    let rsa_sk = jwt.RsaPrivate(c_rsa_priv(encoding.unbase64(lit("")).unwrap()))
    let p256_sk = jwt.EcPrivate(c_ec(true, encoding.unhex(lit("ba4c57252f1112df3ae662fc5e3b1d566490655e225bf7e2ccb8d083d34066be")).unwrap()))
    let p384_sk = jwt.EcPrivate(c_ec(false, encoding.unhex(lit("a7239ecdd1155ca27cbebf364ddcea5b9ed56a4a580e7ddf9533f6972ed46230319605bc87ead7fe6bbf6393d634e9b1")).unwrap()))
    let ed_sk = jwt.Ed25519Seed(c_seed(encoding.unhex(lit("38db505a249ae7bd27531c9e9d23d7da354e001d676c666d10fea7e590f752a5")).unwrap()))
    let hsk = jwt.SecretKey(secret())
    let mut pairs: List[(jwt.Alg, jwt.SigningKey, str)] = List.new()
    pairs.push((jwt.HS256, hsk, "hs1"))
    pairs.push((jwt.HS384, hsk, "hs1"))
    pairs.push((jwt.HS512, hsk, "hs1"))
    pairs.push((jwt.RS256, rsa_sk, "rsa1"))
    pairs.push((jwt.RS384, rsa_sk, "rsa1"))
    pairs.push((jwt.RS512, rsa_sk, "rsa1"))
    pairs.push((jwt.PS256, rsa_sk, "rsa1"))
    pairs.push((jwt.PS384, rsa_sk, "rsa1"))
    pairs.push((jwt.PS512, rsa_sk, "rsa1"))
    pairs.push((jwt.ES256, p256_sk, "p256"))
    pairs.push((jwt.ES384, p384_sk, "p384"))
    pairs.push((jwt.EdDSA, ed_sk, "ed1"))
    for pr in pairs {
        let (a, sk, kid) = pr
        match jwt.sign(a, sk, lit(kid), claims) {
            Ok(t) => {
                let mut vv = jwt.validation(List[a])
                vv.audience = Some(lit("y"))
                show(jwt.alg_name(a), jwt.verify_at(vv, withoct, t, now()))
            }
            Err(e) => io.outln(e.bytes())
        }
    }
    match jwt.sign(jwt.RS256, hsk, List.new(), claims) { Ok(_) => print("signed?!"), Err(e) => io.outln(e.bytes()) }
    match jwt.sign(jwt.HS256, rsa_sk, List.new(), claims) { Ok(_) => print("signed?!"), Err(e) => io.outln(e.bytes()) }
    match jwt.sign(jwt.ES384, p256_sk, List.new(), claims) { Ok(_) => print("signed?!"), Err(e) => io.outln(e.bytes()) }

    io.outln(lit("-- JWKS errors"))
    for d in [r#"{"keys":5}"#, r#"{"nokeys":[]}"#, r#"nope"#, r#"{"keys":[5]}"#, r#"{"keys":[{"kid":"x"}]}"#, r#"{"keys":[{"kty":"RSA","n":"AQAB"}]}"#, r#"{"keys":[{"kty":"RSA","n":"AQAB","e":"AQAB"}]}"#, r#"{"keys":[{"kty":"EC","crv":"P-256","x":"AQ","y":"AQ"}]}"#, r#"{"keys":[{"kty":"oct","k":"!!"}]}"#, r#"{"keys":[{"kty":"unknown"}]}"#, r#"{"keys":[]}"#] {
        match jwt.parse_jwks(lit(d), true) {
            Ok(s) => {
                let mut l = lit("ok ")
                bytes.append(inout l, bytes.from_u64(s.len() as u64))
                io.outln(l)
            }
            Err(e) => io.outln(e.bytes())
        }
    }
}
