// http/static: serving from a fixture tree (target/static-fixture, rebuilt each run), media
// types, caching, ETag/If-None-Match, directory rules, the SPA fallback, and every traversal form
// the path checks must refuse: .., encoded .., %2F, %00, backslashes, absolute and doubled slashes,
// dot files, symlinks out of the root (file, directory, sibling with a common prefix), double
// encoding, overlong UTF-8, control bytes. A secret outside the root must never be served.

import core.sys
import std.bytes
import std.fs
import std.io
import http
import http.router
import http.static
import http.testing

fn lit(s: str) -> List[u8] { sys.lit(s) }

const BASE: str = "target/static-fixture"

fn put(path: str, data: str) uses fs {
    let p = lit(path)
    fs.mkdir_all(fs.dirname(p)).unwrap()
    fs.write(p, lit(data)).unwrap()
}

fn build() uses fs {
    let b = lit(BASE)
    if fs.exists(b) { fs.remove_all(b).unwrap() }
    put("target/static-fixture/www/index.html", "<h1>home</h1>")
    put("target/static-fixture/www/app.3f2a9c1b.js", "console.log(1)")
    put("target/static-fixture/www/plain.js", "console.log(2)")
    put("target/static-fixture/www/style.CSS", "body{{}}")
    put("target/static-fixture/www/mod.wasm", "\u{1}asm")
    put("target/static-fixture/www/data.bin", "bits")
    put("target/static-fixture/www/noext", "no extension")
    put("target/static-fixture/www/a b.txt", "space")
    put("target/static-fixture/www/%2e%2e", "literal percent name")
    put("target/static-fixture/www/sub/index.html", "<h1>sub</h1>")
    put("target/static-fixture/www/sub/page.txt", "page")
    put("target/static-fixture/www/sub/deep/x.txt", "deep")
    put("target/static-fixture/www/empty/.keep", "")
    put("target/static-fixture/www/bare/.keep", "")
    put("target/static-fixture/www/.env", "SECRET=1")
    put("target/static-fixture/www/.git/config", "[core]")
    put("target/static-fixture/www/sub/.hidden", "hidden")
    put("target/static-fixture/www/.well-known/security.txt", "Contact: x")
    put("target/static-fixture/www/big.txt", "0123456789")
    put("target/static-fixture/www-private/secret.txt", "TOP SECRET")
    put("target/static-fixture/outside/secret.txt", "TOP SECRET")
    put("target/static-fixture/secret.txt", "TOP SECRET")
    fs.symlink(lit("sub/page.txt"), lit("target/static-fixture/www/link-in.txt")).unwrap()
    fs.symlink(lit("../secret.txt"), lit("target/static-fixture/www/link-out.txt")).unwrap()
    fs.symlink(lit("../www-private/secret.txt"), lit("target/static-fixture/www/sneak.txt")).unwrap()
    fs.symlink(lit("../outside"), lit("target/static-fixture/www/linkdir")).unwrap()
    fs.symlink(lit("/etc/hostname"), lit("target/static-fixture/www/abs.txt")).unwrap()
    fs.symlink(lit("../outside"), lit("target/static-fixture/www/sub/up")).unwrap()
    fs.symlink(lit("../../secret.txt"), lit("target/static-fixture/www/empty/index.html")).unwrap()
    fs.symlink(lit("nowhere"), lit("target/static-fixture/www/dangling")).unwrap()
}

fn say(label: str, r: http.Response) uses io {
    let mut l = lit(label)
    bytes.append(inout l, lit(" => "))
    bytes.append(inout l, bytes.from_i64(r.status as i64))
    match r.header("content-type") {
        Some(v) => {
            l.push(32)
            bytes.append(inout l, v)
        }
        None => {}
    }
    match r.header("cache-control") {
        Some(v) => {
            bytes.append(inout l, lit(" | "))
            bytes.append(inout l, v)
        }
        None => {}
    }
    match r.header("location") {
        Some(v) => {
            bytes.append(inout l, lit(" -> "))
            bytes.append(inout l, v)
        }
        None => {}
    }
    if r.body.len() > 0 {
        bytes.append(inout l, lit(" | "))
        bytes.append(inout l, r.body)
    }
    io.outln(l)
}

fn inm(c: testing.Client, value: List[u8]) -> http.Response uses io {
    let mut hs: List[http.Header] = List.new()
    hs.push(http.Header(lit("If-None-Match"), value))
    c.send("GET", "/assets/plain.js", hs, List.new())
}

/// Whether the secret leaked in a response.
fn leaked(r: http.Response) -> bool { bytes.find(r.body, lit("SECRET"), 0).is_some() }

fn main() uses io, fs {
    build()
    let mut r = router.new()
    static.mount(inout r, "/assets", "target/static-fixture/www", static.options()).unwrap()
    let c = testing.client(router.handler(r))

    print("-- files and media types")
    say("index", c.get("/assets/"))
    say("hashed js", c.get("/assets/app.3f2a9c1b.js"))
    say("plain js", c.get("/assets/plain.js"))
    say("upper-case extension", c.get("/assets/style.CSS"))
    say("wasm", c.get("/assets/mod.wasm"))
    say("unknown", c.get("/assets/data.bin"))
    say("no extension", c.get("/assets/noext"))
    say("space", c.get("/assets/a%20b.txt"))
    say("deep", c.get("/assets/sub/deep/x.txt"))
    say("missing", c.get("/assets/missing.txt"))
    say("literal %2e%2e file via double encoding", c.get("/assets/%252e%252e"))
    say("link inside the root", c.get("/assets/link-in.txt"))
    for (n, expect) in [("app.3f2a9c1b.js", true), ("app-3F2A9C1B.js", true), ("a1b2c3d4.css", true), ("main.deadbeef.js", false), ("2024-01-01.js", false), ("20240101.js", false), ("app.3f2a9c1.js", false), ("app.3f2a9c1bz.js", false), ("x_0123abcd_y.png", true), ("plain.js", false), ("", false), (".", false), ("chunk-9f8e7d6c5b4a.js", true)] {
        let ok = static.is_hashed(lit(n)) == expect
        if !ok { io.outln(lit(n)) }
        print(ok)
    }

    print("-- validators")
    let first = c.get("/assets/plain.js")
    let tag = first.header("etag").unwrap()
    io.outln(tag)
    let r304 = inm(c, tag)
    say("304", r304)
    print(r304.header("etag").is_some())
    print(inm(c, bytes.concat(lit("\"nope\", W/"), tag)).status)
    print(inm(c, lit("*")).status)
    print(inm(c, lit("\"other\"")).status)
    print(inm(c, lit("")).status)
    print(static.etag(lit("a")) != static.etag(lit("b")))
    print(static.etag(lit("ab")) != static.etag(lit("ba")))
    print(static.etag(lit("")) == static.etag(List.new()))
    io.outln(static.etag(lit("")))
    // HEAD: headers, no body
    let head = c.send("HEAD", "/assets/plain.js", List.new(), List.new())
    print(head.status)
    // methods
    let post = c.post("/assets/plain.js", "text/plain", lit("x"))
    print(post.status)
    io.outln(post.header("allow").unwrap())
    print(c.delete("/assets/plain.js").status)

    print("-- directories")
    say("dir with index", c.get("/assets/sub/"))
    say("dir without slash", c.get("/assets/sub"))
    say("dir without slash, query", c.get("/assets/sub?a=1"))
    say("dir without index", c.get("/assets/bare/"))
    say("dir without index, no slash", c.get("/assets/bare"))
    say("file with a slash", c.get("/assets/plain.js/"))
    say("index that is a link out of the root", c.get("/assets/empty/"))

    print("-- traversal: nothing outside the root is served")
    let mut evil = 0
    let mut served = 0
    for p in ["/assets/sub/../plain.js", "/assets/sub/..%2fplain.js", "/assets/sub/%2e%2e/plain.js", "/assets/sub/%2e%2e%2fplain.js", "/assets/sub/%2E%2e%5Cplain.js", "/assets/sub//plain.js", "/assets/sub/./page.txt", "/assets/%2fplain.js", "/assets/../secret.txt", "/assets/..%2fsecret.txt", "/assets/..%2Fsecret.txt", "/assets/%2e%2e/secret.txt", "/assets/%2E%2E/secret.txt", "/assets/.%2e/secret.txt", "/assets/%2e./secret.txt", "/assets/..%5csecret.txt", "/assets/..\\secret.txt", "/assets/sub/../../secret.txt", "/assets/sub/%2e%2e/%2e%2e/secret.txt", "/assets/sub/..%2f..%2fsecret.txt", "/assets/....//secret.txt", "/assets/..;/secret.txt", "/assets/%2e%2e%2fsecret.txt", "/assets/%2e%2e%2f%2e%2e%2fsecret.txt", "/assets/%c0%ae%c0%ae/secret.txt", "/assets/%c0%ae%c0%ae%c0%afsecret.txt", "/assets/%e0%80%ae%e0%80%ae/secret.txt", "/assets/%252e%252e/secret.txt", "/assets/%252e%252e%252fsecret.txt", "/assets//secret.txt", "/assets//etc/passwd", "/assets/%2fetc%2fpasswd", "/assets/%2Fetc/passwd", "/assets/%2f%2fetc%2fpasswd", "/assets/..", "/assets/../", "/assets/sub/..", "/assets/.", "/assets/./plain.js", "/assets/sub/./page.txt", "/assets/sub//page.txt", "/assets/sub/page.txt/..", "/assets/plain.js%00.png", "/assets/plain.js%00", "/assets/%00", "/assets/%00/../../secret.txt", "/assets/sub/page.txt%0a", "/assets/sub%0d%0aX-Evil:1/", "/assets/plain.js%20", "/assets/%ff", "/assets/%80", "/assets/%c3", "/assets/%01x", "/assets/%1fx", "/assets/%7f", "/assets/x%5cy", "/assets/C:%5cwindows%5cwin.ini", "/assets/link-out.txt", "/assets/sneak.txt", "/assets/linkdir/secret.txt", "/assets/linkdir", "/assets/linkdir/", "/assets/sub/up/secret.txt", "/assets/abs.txt", "/assets/dangling", "/assets/.env", "/assets/.git/config", "/assets/.git/", "/assets/.git", "/assets/sub/.hidden", "/assets/.well-known/security.txt", "/assets/%2eenv", "/assets/%2Eenv", "/assets/.ENV", "/assets/sub/%2ehidden", "/assets/empty/.keep"] {
        let resp = c.get(p)
        let mut l = lit(p)
        bytes.append(inout l, lit(" => "))
        bytes.append(inout l, bytes.from_i64(resp.status as i64))
        io.outln(l)
        if leaked(resp) { evil += 1 }
        if resp.status == 200 { served += 1 }
    }
    print(evil)
    print(served)
    // a client may also send what the testing client's validator refuses; the router and the handler see paths directly
    let mut direct = router.new()
    static.mount(inout direct, "", "target/static-fixture/www", static.options()).unwrap()
    let dh = router.handler(direct)
    let mut nul = lit("/")
    nul.push(0)
    let mut d1 = http.request("GET", lit("/"))
    d1.path = bytes.concat(lit("/sub/page.txt"), nul)
    print(dh(d1).status)
    let mut d2 = http.request("GET", lit("/"))
    d2.path = lit("//etc/passwd")
    print(dh(d2).status)
    let mut d3 = http.request("GET", lit("/"))
    d3.path = lit("//evil.example/")
    print(dh(d3).status)
    let mut d4 = http.request("GET", lit("/"))
    d4.path = lit("/sub")
    d4.query = lit("x=1")
    say("redirect keeps the path", dh(d4))
    let mut d5 = http.request("GET", lit("/"))
    d5.path = lit("//sub")
    print(dh(d5).status)

    print("-- clean_path")
    for p in ["", "a", "a/b", "a/", "/a", "a//b", "a/./b", "a/../b", "..", ".", "a/.b", ".b", "a\\b", "a b", "\u{e9}", "a/b/", "//", "/", ".well-known/x", "a/.well-known/x"] {
        match static.clean_path(lit(p), false) {
            Some(s) => {
                let mut l = lit(p)
                bytes.append(inout l, lit(" ok "))
                bytes.append(inout l, bytes.from_u64(s.len() as u64))
                io.outln(l)
            }
            None => {
                let mut l = lit(p)
                bytes.append(inout l, lit(" refused"))
                io.outln(l)
            }
        }
    }
    print(static.clean_path(lit(".well-known/x"), true).is_some())
    print(static.clean_path(lit("a/.well-known/x"), true).is_some())
    print(static.clean_path(lit(".well-known/.x"), true).is_some())
    let mut ctl = lit("a")
    ctl.push(0)
    print(static.clean_path(ctl, false).is_some())
    let mut bad8 = lit("a")
    bad8.push(255)
    print(static.clean_path(bad8, false).is_some())
    let mut longp: List[u8] = List.new()
    for i in 0..5000 { longp.push(97) }
    print(static.clean_path(longp, false).is_some())

    print("-- options")
    let mut wk = router.new()
    static.mount(inout wk, "", "target/static-fixture/www", static.options().with_well_known()).unwrap()
    let wc = testing.client(router.handler(wk))
    say("well-known allowed", wc.get("/.well-known/security.txt"))
    say("other dot files still not", wc.get("/.env"))
    let mut spa = router.new()
    static.mount(inout spa, "", "target/static-fixture/www", static.options().with_spa("index.html")).unwrap()
    let sc = testing.client(router.handler(spa))
    say("spa route", sc.get("/users/42"))
    say("spa root", sc.get("/"))
    say("missing asset is still 404", sc.get("/missing.js"))
    say("traversal is still 404", sc.get("/..%2fsecret.txt"))
    say("dot file is not the fallback's business", sc.get("/.env"))
    let mut cfg_small = router.new()
    static.mount(inout cfg_small, "/s", "target/static-fixture/www", static.options().with_max_size(11)).unwrap()
    let smc = testing.client(router.handler(cfg_small))
    say("over max_size", smc.get("/s/noext"))
    say("under max_size", smc.get("/s/big.txt"))
    let mut cache = router.new()
    static.mount(inout cache, "/c", "target/static-fixture/www", static.options().with_cache("max-age=1", "max-age=2")).unwrap()
    let cc = testing.client(router.handler(cache))
    say("custom cache, hashed", cc.get("/c/app.3f2a9c1b.js"))
    say("custom cache, other", cc.get("/c/plain.js"))
    match static.dir("target/static-fixture/nope", static.options()) {
        Ok(d) => print("opened?")
        Err(e) => print("missing root refused")
    }
    match static.dir("target/static-fixture/www/plain.js", static.options()) {
        Ok(d) => print("opened?")
        Err(e) => io.outln(e.bytes())
    }
    match static.dir("target/static-fixture/www", static.options().with_index("a/b")) {
        Ok(d) => print("opened?")
        Err(e) => io.outln(e.bytes())
    }
    match static.dir("target/static-fixture/www", static.options().with_spa("../secret.txt")) {
        Ok(d) => print("opened?")
        Err(e) => io.outln(e.bytes())
    }
    // a root reached through a symlink works, and the sibling check uses the canonical root
    fs.symlink(lit("www"), lit("target/static-fixture/rootlink")).unwrap()
    let mut viaroot = router.new()
    static.mount(inout viaroot, "", "target/static-fixture/rootlink", static.options()).unwrap()
    let vc = testing.client(router.handler(viaroot))
    say("root through a link", vc.get("/sub/page.txt"))
    say("sibling prefix through it", vc.get("/sneak.txt"))
    fs.remove_all(lit(BASE)).unwrap()
}
