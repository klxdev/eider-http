// http/profiling in a build WITH --profile (scripts/test.sh runs this file with --profile=cpu,mem;
// observe_test has the refusals of a build without it): the endpoints answer a profile that
// names the program, remote peers are refused, seconds are validated.

import core.sys
import std.bytes
import std.io
import std.profile
import http
import http.router
import http.testing
import http.profiling

fn lit(s: str) -> List[u8] { sys.lit(s) }

fn main() uses io, fs, clock {
    print(profile.enabled())
    let mut opts = profiling.options()
    opts.enabled = true
    opts.max_seconds = 2
    let mut r = router.new()
    r.get("/work/:n", |q: http.Request| -> http.Response { http.text(200, "worked") })
    profiling.label_routes(inout r)
    profiling.mount(inout r, opts)
    let c = testing.client(router.handler(r))
    let w = c.get("/work/1")
    print(w.status)
    let h = c.get("/debug/heap")
    print(h.status)
    io.outln(h.header("content-type").unwrap_or(lit("-")))
    io.outln(h.header("cache-control").unwrap_or(lit("-")))
    // the first line is the header of a version 1 profile
    print(bytes.starts_with(h.body, lit("{{\"eider_prof\":1")))
    print(bytes.find(h.body, lit("profiling_test.ei"), 0).is_some())
    print(c.from_peer("203.0.113.9:1").get("/debug/heap").status)
    print(c.from_peer("[2001:db8::1]:1").get("/debug/profile?seconds=1").status)
    print(c.get("/debug/profile?seconds=0").status)
    print(c.get("/debug/profile?seconds=3").status)
    print(c.get("/debug/profile?seconds=x").status)
    print(c.get("/debug/profile?seconds=-1").status)
    let p = c.get("/debug/profile?seconds=1")
    print(p.status)
    print(bytes.starts_with(p.body, lit("{{\"eider_prof\":1")))
    let mut remote = profiling.options()
    remote.enabled = true
    remote.remote = true
    let mut r2 = router.new()
    profiling.mount(inout r2, remote)
    print(testing.client(router.handler(r2)).from_peer("203.0.113.9:1").get("/debug/heap").status)
}
