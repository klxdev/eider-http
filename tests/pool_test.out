-- the program's own Cookie header is kept and the jar's added
GET path=/who auth=[-] cookie=[mine=1; theme=dark; sid=abc] x=[-] ct=[-] body=[]
-- a cookie set during a redirect is sent to the next hop
200 GET path=/who auth=[-] cookie=[theme=dark; sid=abc; hop=1] x=[-] ct=[-] body=[]
