-- the same origin keeps them
GET path=/who auth=[Bearer secret] cookie=[sid=1] x=[on] ct=[-] body=[]
-- another port is another origin: no Authorization, no Cookie (X-Default stays)
GET path=/who auth=[-] cookie=[-] x=[on] ct=[-] body=[]
-- and the call's own Authorization goes too, also across a chain that comes back
GET path=/who auth=[-] cookie=[-] x=[on] ct=[-] body=[]
-- 307 across origins keeps the method and the body, not the credentials
POST path=/who auth=[-] cookie=[-] x=[on] ct=[text/plain] body=[data]
-- the URL of the answer names the second server
200 GET path=/who auth=[-] cookie=[-] x=[on] ct=[-] body=[] | url=http://127.0.0.1:PORT2/who redirects=1
true
true
