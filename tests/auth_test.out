-- bearer middleware
401 Bearer realm="api" | {"type":"about:blank","title":"Unauthorized","status":401,"detail":"this operation needs a bearer token"}
200 [principal=ada] | hello ada Bearer scope=
200 [principal=bob] | hello bob Bearer scope=
401 Bearer realm="api", error="invalid_token" | {"type":"about:blank","title":"Unauthorized","status":401,"detail":"the bearer token is not valid"}
