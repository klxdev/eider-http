//! http/metrics: request counters and a latency histogram, exposed in the Prometheus text
//! exposition format (version 0.0.4) for a scraper to read from `GET /metrics`.
//!
//!     let m = metrics.new()
//!     r.get("/metrics", m.handler())
//!     let app = m.wrap(router.handler(r))
//!
//! Series:
//!   http_requests_total{method, code}        counter: requests answered (`by_route`: and route)
//!   http_requests_in_flight                  gauge: requests being handled now
//!   http_request_duration_seconds{le}        histogram: time in the wrapped handler (`by_route`: one
//!                                            histogram per route, `{route, le}`)
//! `method` is one of GET HEAD POST PUT PATCH DELETE OPTIONS or OTHER (a client chooses the
//! method, so it can't be allowed to make new series); `code` is the status. Series are
//! written sorted by method, then code, so the output is stable. A `Metrics` is shared by its
//! copies (one Lock), so the handler that serves it and the wrapper that counts see the same
//! numbers from every worker thread.

import core.sys
import std.bytes
import std.sort
import std.sync
import std.time
import http

type Key = { method: List[u8], route: List[u8], code: i32 }

type Hist = { buckets: List[i64], sum_ns: i64, count: i64 }

type St = { counts: Map[Key, i64], hists: Map[List[u8], Hist], in_flight: i64 }

/// Counters shared by copies (see the module comment). `bounds_us`: the histogram's upper
/// bounds in microseconds, ascending.
pub type Metrics = { st: sync.Lock[St], bounds_us: List[i64], per_route: bool }

/// Prometheus's default buckets: 5 ms to 10 s.
pub fn new() -> Metrics {
    let mut b: List[i64] = List.new()
    for x in [5000, 10000, 25000, 50000, 100000, 250000, 500000, 1000000, 2500000, 5000000, 10000000] { b.push(x as i64) }
    with_buckets(b)
}

/// A histogram with these upper bounds (microseconds, ascending; `+Inf` is added).
pub fn with_buckets(bounds_us: List[i64]) -> Metrics {
    Metrics(sync.lock(St(Map.new(), Map.new(), 0)), bounds_us, false)
}

/// The same series labelled by route as well (`http_requests_total{method,route,code}`, a latency
/// histogram per route): the label is the route pattern the router matched (`/todos/:id`), the
/// operation id when an OpenAPI service set one, and `unmatched` for requests no route took
/// (404, 405), so a client can't make new series. Copies share the numbers.
pub fn by_route(m: Metrics) -> Metrics { Metrics(m.st, m.bounds_us, true) }

/// The method as a label value (see the module comment).
pub fn method_label(m: List[u8]) -> List[u8] {
    for k in ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] {
        if bytes.eq(m, sys.lit(k)) { return m }
    }
    sys.lit("OTHER")
}

/// Microseconds as seconds in decimal ("0.005", "2.5", "10").
pub fn seconds_text(us: i64) -> List[u8] {
    let mut out = bytes.from_i64(us / 1000000)
    let mut frac = us % 1000000
    if frac == 0 { return out }
    out.push(46)
    let mut digits: List[u8] = List.new()
    let mut div: i64 = 100000
    while div > 0 {
        digits.push((48 + frac / div) as u8)
        frac = frac % div
        div = div / 10
    }
    let mut n = digits.len()
    while n > 0 && digits[n - 1] == 48 { n -= 1 }
    bytes.append(inout out, bytes.slice(digits, 0, n))
    out
}

/// Nanoseconds as seconds with nine decimals trimmed ("0.000123").
fn ns_seconds(ns: i64) -> List[u8] {
    let mut out = bytes.from_i64(ns / 1000000000)
    let mut frac = ns % 1000000000
    if frac == 0 { return out }
    out.push(46)
    let mut digits: List[u8] = List.new()
    let mut div: i64 = 100000000
    while div > 0 {
        digits.push((48 + frac / div) as u8)
        frac = frac % div
        div = div / 10
    }
    let mut n = digits.len()
    while n > 0 && digits[n - 1] == 48 { n -= 1 }
    bytes.append(inout out, bytes.slice(digits, 0, n))
    out
}

/// A label value: `\\`, `"` and newline escaped, as the exposition format asks.
fn escape(v: List[u8]) -> List[u8] {
    let mut o: List[u8] = List.new()
    for c in v {
        if c == 92 || c == 34 {
            o.push(92)
            o.push(c)
        } else if c == 10 {
            o.push(92)
            o.push(110)
        } else {
            o.push(c)
        }
    }
    o
}

fn line(inout out: List[u8], s: str) {
    bytes.append(inout out, sys.lit(s))
    out.push(10)
}

impl Metrics {
    /// Counts one answered request that took `dur_ns` (no route: `observe_route` with "").
    fn observe(self, method: List[u8], status: i32, dur_ns: i64) { self.observe_route(method, List.new(), status, dur_ns) }

    /// Counts one answered request on `route` (used as a label when `by_route`).
    fn observe_route(self, method: List[u8], route: List[u8], status: i32, dur_ns: i64) {
        let label: List[u8] = if self.per_route { route.copy() } else { List.new() }
        let k = Key(method_label(method), label.copy(), status)
        let us = dur_ns / 1000
        let bs = self.bounds_us
        self.st.modify(|inout t: St| -> () {
            t.counts.insert(k, t.counts.get(k).unwrap_or(0) + 1)
            let mut h = match t.hists.get(label) {
                Some(x) => x
                None => {
                    let mut zero: List[i64] = List.new()
                    for j in 0..bs.len() { zero.push(0) }
                    Hist(zero, 0, 0)
                }
            }
            for i in 0..bs.len() {
                if us <= bs[i] { h.buckets[i] += 1 }
            }
            h.sum_ns += dur_ns
            h.count += 1
            t.hists.insert(label, h)
        })
    }

    fn enter(self) { self.st.modify(|inout t: St| -> () { t.in_flight += 1 }) }

    fn leave(self) { self.st.modify(|inout t: St| -> () { t.in_flight -= 1 }) }

    /// Counts every request `h` answers, and how long it took.
    fn wrap(self, h: http.Handler) -> http.Handler uses clock {
        let m = self
        |req: http.Request| -> http.Response {
            m.enter()
            let t0 = time.mono_ns()
            let resp = h(req)
            let d = time.mono_ns() - t0
            m.leave()
            let route = match resp.get_ctx("operation") {
                Some(o) => o
                None => resp.get_ctx("route").unwrap_or(sys.lit("unmatched"))
            }
            m.observe_route(req.method, route, resp.status, d)
            resp
        }
    }

    /// Requests answered with `status` (any method).
    fn total(self, status: i32) -> i64 {
        let s = self.st.get()
        let mut n: i64 = 0
        for (k, c) in s.counts {
            if k.code == status { n += c }
        }
        n
    }

    /// The exposition text (see the module comment).
    fn render(self) -> List[u8] {
        let s = self.st.get()
        let keys = sort.sort_by(s.counts.keys(), |a: Key, b: Key| -> Ordering {
            let c = bytes.compare(a.method, b.method)
            if c < 0 { return Less }
            if c > 0 { return Greater }
            let r = bytes.compare(a.route, b.route)
            if r < 0 { return Less }
            if r > 0 { return Greater }
            a.code.compare(b.code)
        })
        let mut out: List[u8] = List.new()
        line(inout out, "# HELP http_requests_total Requests answered, by method and status code.")
        line(inout out, "# TYPE http_requests_total counter")
        for k in keys {
            bytes.append(inout out, sys.lit("http_requests_total{{method=\""))
            bytes.append(inout out, k.method)
            if self.per_route {
                bytes.append(inout out, sys.lit("\",route=\""))
                bytes.append(inout out, escape(k.route))
            }
            bytes.append(inout out, sys.lit("\",code=\""))
            bytes.append(inout out, bytes.from_i64(k.code as i64))
            bytes.append(inout out, sys.lit("\"}} "))
            bytes.append(inout out, bytes.from_i64(s.counts.get(k).unwrap_or(0)))
            out.push(10)
        }
        line(inout out, "# HELP http_requests_in_flight Requests being handled now.")
        line(inout out, "# TYPE http_requests_in_flight gauge")
        bytes.append(inout out, sys.lit("http_requests_in_flight "))
        bytes.append(inout out, bytes.from_i64(s.in_flight))
        out.push(10)
        line(inout out, "# HELP http_request_duration_seconds Time to answer a request.")
        line(inout out, "# TYPE http_request_duration_seconds histogram")
        let mut labels: List[List[u8]] = List.new()
        if self.per_route {
            labels = sort.sort_by(s.hists.keys(), |a: List[u8], b: List[u8]| -> Ordering {
                let c = bytes.compare(a, b)
                if c < 0 { return Less }
                if c > 0 { return Greater }
                Equal
            })
        } else {
            labels.push(List.new())
        }
        for label in labels {
            let h = match s.hists.get(label) {
                Some(x) => x
                None => {
                    let mut zero: List[i64] = List.new()
                    for j in 0..self.bounds_us.len() { zero.push(0) }
                    Hist(zero, 0, 0)
                }
            }
            let mut lab: List[u8] = List.new()
            if self.per_route {
                bytes.append(inout lab, sys.lit("route=\""))
                bytes.append(inout lab, escape(label))
                bytes.append(inout lab, sys.lit("\","))
            }
            for i in 0..self.bounds_us.len() {
                bytes.append(inout out, sys.lit("http_request_duration_seconds_bucket{{"))
                bytes.append(inout out, lab)
                bytes.append(inout out, sys.lit("le=\""))
                bytes.append(inout out, seconds_text(self.bounds_us[i]))
                bytes.append(inout out, sys.lit("\"}} "))
                bytes.append(inout out, bytes.from_i64(h.buckets[i]))
                out.push(10)
            }
            bytes.append(inout out, sys.lit("http_request_duration_seconds_bucket{{"))
            bytes.append(inout out, lab)
            bytes.append(inout out, sys.lit("le=\"+Inf\"}} "))
            bytes.append(inout out, bytes.from_i64(h.count))
            out.push(10)
            let mut tail: List[u8] = List.new()
            if self.per_route {
                tail.push(123)
                bytes.append(inout tail, bytes.slice(lab, 0, lab.len() - 1))
                tail.push(125)
            }
            bytes.append(inout out, sys.lit("http_request_duration_seconds_sum"))
            bytes.append(inout out, tail)
            out.push(32)
            bytes.append(inout out, ns_seconds(h.sum_ns))
            out.push(10)
            bytes.append(inout out, sys.lit("http_request_duration_seconds_count"))
            bytes.append(inout out, tail)
            out.push(32)
            bytes.append(inout out, bytes.from_i64(h.count))
            out.push(10)
        }
        out
    }

    /// A handler answering with `render()` (`text/plain; version=0.0.4`).
    fn handler(self) -> http.Handler {
        let m = self
        |req: http.Request| -> http.Response { http.respond(200, "text/plain; version=0.0.4; charset=utf-8", m.render()) }
    }
}
